---
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

const norm = (s: string) => (s.endsWith('/') ? s : `${s}/`);

const links = [
  { href: base, icon: '🏠', label: 'Inicio' },
  { href: `${base}votaciones`, icon: '🗳️', label: 'Encuestas' },
  { href: `${base}resultados`, icon: '📊', label: 'Resultados' },
  { href: `${base}palmares`, icon: '🏆', label: 'Palmarés' },
  { href: `${base}identidad`, icon: '👤', label: 'Perfil' },
];
---

<nav class="navbar" aria-label="Navegación principal">
  {
    links.map((l) => (
      <a
        href={l.href}
        class={`navbar-link ${norm(path) === norm(l.href) ? 'is-active' : ''}`}
        data-astro-prefetch
      >
        <span class="navbar-icon">{l.icon}</span>
        <span class="navbar-label">{l.label}</span>
      </a>
    ))
  }
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    justify-content: space-around;
    background: rgba(11, 18, 16, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .navbar-link {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding: 0.55rem 0.25rem;
    color: var(--text-dim);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.65rem;
    text-align: center;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .navbar-link:hover {
    color: var(--text);
  }

  .navbar-link.is-active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .navbar-icon {
    font-size: 1.25rem;
    line-height: 1;
  }

  .navbar-label {
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .navbar-link {
      flex-direction: row;
      gap: 0.4rem;
      padding: 0.85rem 0.5rem;
      font-size: 0.85rem;
    }

    .navbar-icon {
      font-size: 1.1rem;
    }
  }
</style>
