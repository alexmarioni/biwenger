---
import Base from '../layouts/Base.astro';
---

<Base title="Puntaje">
  <main class="wrap puntaje">
    <header class="top-bar animate-in">
      <div>
        <p class="hello" id="hello-msg">Hola 👋</p>
        <h1>🏅 Puntaje</h1>
      </div>
      <div class="top-actions">
        <button id="change-player" class="btn btn-ghost" type="button">Cambiar de jugador</button>
      </div>
    </header>

    <p class="puntaje-rules">
      3 pts por partido de Jornada acertado · 10 pts por acertar Goleador/Asistidor/MVP/Último equipo ·
      Clasificación: hasta 5 pts por equipo según qué tan cerca quedó tu posición de la real (se compara contra
      la tabla actual, todavía no la final). Solo puntúan predicciones ya resueltas.
    </p>

    <div id="state-loading" class="state-msg">Cargando puntaje…</div>
    <div id="state-error" class="state-msg error" hidden>
      No se pudo conectar con la base. Revisá tu conexión o probá de nuevo en un rato.
    </div>
    <div id="state-empty" class="state-msg" hidden>Todavía no hay ninguna predicción resuelta para puntuar.</div>

    <section id="leaderboard" class="leaderboard" hidden></section>
  </main>
</Base>

<style>
  .puntaje {
    gap: 1.5rem;
  }

  @media (min-width: 860px) {
    .puntaje {
      max-width: 50rem;
    }
  }

  .top-bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .top-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .hello {
    color: var(--text-dim);
    margin: 0 0 0.15rem;
    font-size: 0.95rem;
  }

  h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
  }

  .puntaje-rules {
    color: var(--text-dim);
    font-size: 0.82rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.9rem 1.1rem;
  }

  .state-msg {
    color: var(--text-dim);
    padding: 2rem 0;
    text-align: center;
  }

  .state-msg.error {
    color: var(--danger);
  }

  .leaderboard {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { getStoredPlayer, clearStoredPlayer } from '../lib/identity';
  import { redirectIfMaintenance } from '../lib/maintenance';
  import { playerAvatarHtml } from '../lib/playerAvatar';
  import { computeScores } from '../lib/scoring';

  const base = import.meta.env.BASE_URL;

  document.addEventListener('astro:page-load', start);

  async function start() {
    if (await redirectIfMaintenance(base)) return;

    const player = getStoredPlayer();
    if (!player) {
      window.location.href = `${base}identidad`;
    } else {
      document.getElementById('hello-msg')!.innerHTML = `Hola, ${playerAvatarHtml(player, base)} ${player.name}`;
      document.getElementById('change-player')!.addEventListener('click', () => {
        clearStoredPlayer();
        window.location.href = `${base}identidad`;
      });
      init();
    }
  }

  async function init() {
    const loading = document.getElementById('state-loading')!;
    const errorMsg = document.getElementById('state-error')!;
    const empty = document.getElementById('state-empty')!;

    const [pollsRes, resultsRes, votesRes, playersRes] = await Promise.all([
      supabase
        .from('polls')
        .select('id, category, poll_type, poll_options(id, label)')
        .in('category', ['Jornada', 'Minijuegos', 'Clasificación']),
      supabase.from('poll_results').select('poll_id, correct_option_id, correct_text, correct_order, is_final'),
      supabase.from('votes').select('poll_id, option_id, text_value, player_id'),
      supabase.from('players').select('id, name, emoji, avatar_url'),
    ]);

    loading.hidden = true;

    if (pollsRes.error || resultsRes.error || votesRes.error || playersRes.error) {
      errorMsg.hidden = false;
      return;
    }

    const polls = pollsRes.data ?? [];
    const results = resultsRes.data ?? [];
    const votes = votesRes.data ?? [];
    const players = playersRes.data ?? [];

    if (results.length === 0) {
      empty.hidden = false;
      return;
    }

    const scores = computeScores(polls, results, votes, players);
    const resolvedCount = results.length;

    const board = document.getElementById('leaderboard')!;
    board.hidden = false;

    const MEDALS: Record<number, string> = { 0: '🥇', 1: '🥈', 2: '🥉' };
    board.innerHTML = scores
      .map((s, i) => {
        const p = players.find((pl) => pl.id === s.playerId);
        if (!p) return '';
        const categories = Object.entries(s.byCategory)
          .map(([cat, pts]) => `<span class="score-cat">${cat}: ${pts}</span>`)
          .join('');
        return `
          <div class="score-row${i === 0 && s.total > 0 ? ' is-first' : ''}">
            <span class="score-rank">${MEDALS[i] ?? i + 1}</span>
            ${playerAvatarHtml(p, base, 'score-avatar')}
            <div class="score-info">
              <span class="score-name">${p.name}</span>
              <span class="score-breakdown">${categories || 'Sin puntos todavía'}</span>
            </div>
            <span class="score-total">${s.total}</span>
          </div>
        `;
      })
      .join('');

    const note = document.createElement('p');
    note.className = 'puntaje-rules';
    note.style.marginTop = '0.5rem';
    note.textContent = `${resolvedCount} ${resolvedCount === 1 ? 'predicción resuelta' : 'predicciones resueltas'} hasta ahora.`;
    board.after(note);
  }
</script>
