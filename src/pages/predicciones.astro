---
import Base from '../layouts/Base.astro';
---

<Base title="Predicciones">
  <main class="wrap predicciones">
    <header class="top-bar animate-in">
      <div>
        <p class="hello" id="hello-msg">Hola 👋</p>
        <h1>🎯 Predicciones</h1>
      </div>
      <div class="top-actions">
        <button id="change-player" class="btn btn-ghost" type="button">Cambiar de jugador</button>
      </div>
    </header>

    <div id="state-loading" class="state-msg">Cargando predicciones…</div>
    <div id="state-error" class="state-msg error" hidden>
      No se pudo conectar con la base. Revisá tu conexión o probá de nuevo en un rato.
    </div>
    <div id="state-empty" class="state-msg" hidden>Todavía no hay nada para pronosticar.</div>

    <div id="sections" class="pred-sections" hidden>
      <section id="jornada-section" class="pred-section" hidden>
        <h2 class="pred-heading">⚽ Jornada</h2>
        <div id="jornada-list" class="jornada-list"></div>
      </section>

      <section id="minijuegos-section" class="pred-section" hidden>
        <h2 class="pred-heading">🎮 Minijuegos</h2>
        <div id="minijuegos-list" class="pred-poll-list"></div>
      </section>

      <section id="clasificacion" class="pred-section" hidden>
        <h2 class="pred-heading">🏆 Clasificación</h2>
        <div id="clasificacion-body"></div>
      </section>

      <section id="fichajes-section" class="pred-section" hidden>
        <h2 class="pred-heading">📰 Fichajes recientes</h2>
        <p class="fichajes-updated" id="fichajes-updated"></p>
        <div id="fichajes-list" class="fichajes-list"></div>
      </section>
    </div>
  </main>
</Base>

<style>
  .predicciones {
    gap: 1.75rem;
  }

  @media (min-width: 860px) {
    .predicciones {
      max-width: 76rem;
    }
  }

  .top-bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .top-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .hello {
    color: var(--text-dim);
    margin: 0 0 0.15rem;
    font-size: 0.95rem;
  }

  h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
  }

  .state-msg {
    color: var(--text-dim);
    padding: 2rem 0;
    text-align: center;
  }

  .state-msg.error {
    color: var(--danger);
  }

  .pred-sections {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .pred-heading {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--gold);
    margin: 0 0 1rem;
  }

  .fichajes-updated {
    color: var(--text-dim);
    font-size: 0.78rem;
    margin: -0.4rem 0 1rem;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { getStoredPlayer, clearStoredPlayer } from '../lib/identity';
  import { redirectIfMaintenance } from '../lib/maintenance';
  import { renderMatchCard } from '../lib/matchCard';
  import { renderPollCard } from '../lib/pollCard';
  import { renderRankingCard } from '../lib/rankingCard';
  import { renderRankingComparison } from '../lib/rankingComparison';
  import { playerAvatarHtml } from '../lib/playerAvatar';
  import { crestPath } from '../lib/crests';

  const base = import.meta.env.BASE_URL;

  document.addEventListener('astro:page-load', start);

  async function start() {
    if (await redirectIfMaintenance(base)) return;

    const player = getStoredPlayer();
    if (!player) {
      window.location.href = `${base}identidad`;
    } else {
      document.getElementById('hello-msg')!.innerHTML = `Hola, ${playerAvatarHtml(player, base)} ${player.name}`;
      document.getElementById('change-player')!.addEventListener('click', () => {
        clearStoredPlayer();
        window.location.href = `${base}identidad`;
      });
      init(player);
      loadFichajes();
    }
  }

  function clubHtml(name: string): string {
    const path = crestPath(name);
    return path
      ? `<span class="fichaje-club"><img class="fichaje-crest" src="${base}${path}" alt="${name}" />${name}</span>`
      : `<span class="fichaje-club">${name}</span>`;
  }

  async function loadFichajes() {
    try {
      const res = await fetch(`${base}data/transfers.json`);
      if (!res.ok) return;
      const data = await res.json();
      const transfers: any[] = data.transfers ?? [];
      if (transfers.length === 0) return;

      document.getElementById('fichajes-section')!.hidden = false;
      const updated = data.generated_at ? new Date(data.generated_at).toLocaleDateString('es-AR') : '';
      document.getElementById('fichajes-updated')!.textContent = `Actualizado ${updated} · fuente: Wikipedia`;

      document.getElementById('fichajes-list')!.innerHTML = transfers
        .slice(0, 15)
        .map(
          (t) => `
        <div class="fichaje-row">
          <span class="fichaje-date">${t.date ?? ''}</span>
          <span class="fichaje-player">${t.player}</span>
          <span class="fichaje-move">${clubHtml(t.from)} → ${clubHtml(t.to)}</span>
          <span class="fichaje-fee">${t.fee ?? ''}</span>
        </div>
      `
        )
        .join('');
    } catch {
      /* informational widget only — fail silently */
    }
  }

  let allVotesState: any[] = [];

  async function init(player: { id: string; name: string; emoji: string }) {
    const loading = document.getElementById('state-loading')!;
    const errorMsg = document.getElementById('state-error')!;
    const empty = document.getElementById('state-empty')!;

    const [pollsRes, votesRes, playersRes] = await Promise.all([
      supabase
        .from('polls')
        .select(
          'id, title, description, status, poll_type, category, created_at, venue, kickoff_at, poll_options(id, label, hint, sort_order)'
        )
        .in('category', ['Jornada', 'Minijuegos', 'Clasificación'])
        .order('created_at', { ascending: true })
        .order('sort_order', { foreignTable: 'poll_options', ascending: true }),
      supabase.from('votes').select('id, poll_id, option_id, text_value, player_id'),
      supabase.from('players').select('id, name, emoji, avatar_url'),
    ]);

    loading.hidden = true;

    if (pollsRes.error || votesRes.error || playersRes.error) {
      errorMsg.hidden = false;
      return;
    }

    const polls = pollsRes.data ?? [];
    allVotesState = votesRes.data ?? [];
    const players = playersRes.data ?? [];

    if (polls.length === 0) {
      empty.hidden = false;
      return;
    }

    document.getElementById('sections')!.hidden = false;

    const jornada = polls
      .filter((p) => p.category === 'Jornada')
      .sort((a, b) => (a.kickoff_at ?? '').localeCompare(b.kickoff_at ?? ''));
    const minijuegos = polls.filter((p) => p.category === 'Minijuegos');
    const clasificacion = polls.find((p) => p.category === 'Clasificación');

    if (jornada.length > 0) {
      document.getElementById('jornada-section')!.hidden = false;
      const list = document.getElementById('jornada-list')!;
      for (const poll of jornada) {
        list.appendChild(
          renderMatchCard(
            poll,
            allVotesState,
            player,
            (updated) => {
              allVotesState = updated;
            },
            base
          )
        );
      }
    }

    if (minijuegos.length > 0) {
      document.getElementById('minijuegos-section')!.hidden = false;
      const list = document.getElementById('minijuegos-list')!;
      for (const poll of minijuegos) {
        list.appendChild(
          renderPollCard(poll, allVotesState, player, (updated) => {
            allVotesState = updated;
          })
        );
      }
    }

    if (clasificacion) {
      document.getElementById('clasificacion')!.hidden = false;
      const body = document.getElementById('clasificacion-body')!;
      let comparisonEl = renderRankingComparison(clasificacion, allVotesState, players, base);

      body.appendChild(
        renderRankingCard(
          clasificacion,
          allVotesState,
          player,
          players,
          (updated) => {
            allVotesState = updated;
            const fresh = renderRankingComparison(clasificacion, allVotesState, players, base);
            comparisonEl.replaceWith(fresh);
            comparisonEl = fresh;
          },
          base
        )
      );
      body.appendChild(comparisonEl);
    }
  }
</script>
