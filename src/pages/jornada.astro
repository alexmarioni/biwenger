---
import Base from '../layouts/Base.astro';
---

<Base title="Jornada">
  <main class="wrap jornada-page">
    <header class="top-bar animate-in">
      <div>
        <p class="hello" id="hello-msg">Hola 👋</p>
        <h1>⚽ Jornada</h1>
      </div>
      <div class="top-actions">
        <button id="change-player" class="btn btn-ghost" type="button">Cambiar de jugador</button>
      </div>
    </header>

    <div id="state-loading" class="state-msg">Cargando partidos…</div>
    <div id="state-error" class="state-msg error" hidden>
      No se pudo conectar con la base. Revisá tu conexión o probá de nuevo en un rato.
    </div>
    <div id="state-empty" class="state-msg" hidden>
      Todavía no hay partidos cargados para pronosticar.
    </div>

    <section id="matches-list" class="jornada-list stagger" hidden></section>
  </main>
</Base>

<style>
  .jornada-page {
    gap: 1.75rem;
  }

  .top-bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .top-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .hello {
    color: var(--text-dim);
    margin: 0 0 0.15rem;
    font-size: 0.95rem;
  }

  h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
  }

  .state-msg {
    color: var(--text-dim);
    padding: 2rem 0;
    text-align: center;
  }

  .state-msg.error {
    color: var(--danger);
  }

  .jornada-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.1rem;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { getStoredPlayer, clearStoredPlayer } from '../lib/identity';
  import { redirectIfMaintenance } from '../lib/maintenance';
  import { renderMatchCard } from '../lib/matchCard';
  import { playerAvatarHtml } from '../lib/playerAvatar';

  const base = import.meta.env.BASE_URL;

  document.addEventListener('astro:page-load', start);

  async function start() {
    if (await redirectIfMaintenance(base)) return;

    const player = getStoredPlayer();
    if (!player) {
      window.location.href = `${base}identidad`;
    } else {
      document.getElementById('hello-msg')!.innerHTML = `Hola, ${playerAvatarHtml(player, base)} ${player.name}`;
      document.getElementById('change-player')!.addEventListener('click', () => {
        clearStoredPlayer();
        window.location.href = `${base}identidad`;
      });
      init(player);
    }
  }

  async function init(player: { id: string; name: string; emoji: string }) {
    const loading = document.getElementById('state-loading')!;
    const errorMsg = document.getElementById('state-error')!;
    const empty = document.getElementById('state-empty')!;
    const list = document.getElementById('matches-list')!;

    const [pollsRes, votesRes] = await Promise.all([
      supabase
        .from('polls')
        .select('id, title, description, status, poll_type, category, venue, kickoff_at, poll_options(id, label, hint, sort_order)')
        .eq('category', 'Jornada')
        .order('kickoff_at', { ascending: true }),
      supabase.from('votes').select('id, poll_id, option_id, text_value, player_id'),
    ]);

    loading.hidden = true;

    if (pollsRes.error || votesRes.error) {
      errorMsg.hidden = false;
      return;
    }

    const matches = pollsRes.data ?? [];
    let allVotesState = votesRes.data ?? [];

    if (matches.length === 0) {
      empty.hidden = false;
      return;
    }

    list.hidden = false;
    for (const poll of matches) {
      list.appendChild(
        renderMatchCard(
          poll,
          allVotesState,
          player,
          (updated) => {
            allVotesState = updated;
          },
          base
        )
      );
    }
  }
</script>
