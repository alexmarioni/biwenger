---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="Palmarés">
  <main class="wrap palmares">
    <header class="top-bar animate-in">
      <div>
        <p class="hello">🏆</p>
        <h1>Palmarés de la liga</h1>
      </div>
      <div class="top-actions">
        <a class="btn btn-ghost" href={`${base}votaciones`}>Votar</a>
        <a class="btn btn-ghost" href={`${base}resultados`}>Resultados</a>
      </div>
    </header>

    <div id="state-loading" class="state-msg">Cargando palmarés…</div>
    <div id="state-error" class="state-msg error" hidden>
      No se pudo conectar con la base. Revisá tu conexión o probá de nuevo en un rato.
    </div>

    <div id="season-label" class="season-label" hidden></div>
    <section id="podium" class="podium" hidden></section>
  </main>
</Base>

<style>
  .palmares {
    gap: 1.75rem;
  }

  .top-bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .top-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .hello {
    margin: 0 0 0.15rem;
    font-size: 1.5rem;
  }

  h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
  }

  .state-msg {
    color: var(--text-dim);
    padding: 2rem 0;
    text-align: center;
  }

  .state-msg.error {
    color: var(--danger);
  }

  .season-label {
    text-align: center;
    color: var(--text-dim);
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
  }

  .podium {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 1rem;
    padding: 1rem 0 2rem;
  }

  :global(.podium-spot) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    opacity: 0;
    animation: pop-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  :global(.podium-spot-1) { order: 2; animation-delay: 0.15s; }
  :global(.podium-spot-2) { order: 1; animation-delay: 0.05s; }
  :global(.podium-spot-3) { order: 3; animation-delay: 0.25s; }

  :global(.podium-avatar) {
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 50%;
    background: var(--bg-card);
    border: 2px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    overflow: hidden;
  }

  :global(.podium-spot-1 .podium-avatar) {
    width: 7rem;
    height: 7rem;
    border-color: var(--gold);
    font-size: 2.5rem;
  }

  :global(.podium-avatar img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.podium-medal) {
    font-size: 1.5rem;
  }

  :global(.podium-name) {
    font-family: var(--font-display);
    font-weight: 600;
    text-align: center;
    max-width: 8rem;
  }

  :global(.podium-block) {
    width: 6.5rem;
    border-radius: 12px 12px 0 0;
    background: linear-gradient(160deg, var(--bg-card), var(--bg-elevated));
    border: 1px solid var(--border);
    border-bottom: none;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 0.5rem;
    color: var(--text-dim);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
  }

  :global(.podium-spot-1 .podium-block) { height: 7rem; border-color: var(--gold); color: var(--gold); }
  :global(.podium-spot-2 .podium-block) { height: 5rem; }
  :global(.podium-spot-3 .podium-block) { height: 3.5rem; }

  .state-msg.empty {
    padding: 3rem 0;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { redirectIfMaintenance } from '../lib/maintenance';

  const base = import.meta.env.BASE_URL;
  const MEDALS: Record<number, string> = { 1: '🥇', 2: '🥈', 3: '🥉' };

  start();

  async function start() {
    if (await redirectIfMaintenance(base)) return;
    init();
  }

  async function init() {
    const loading = document.getElementById('state-loading')!;
    const errorMsg = document.getElementById('state-error')!;
    const seasonLabel = document.getElementById('season-label')!;
    const podium = document.getElementById('podium')!;

    const { data, error } = await supabase
      .from('palmares')
      .select('season, position, name, image_url')
      .order('position', { ascending: true });

    loading.hidden = true;

    if (error) {
      errorMsg.hidden = false;
      return;
    }

    if (!data || data.length === 0) {
      loading.hidden = false;
      loading.textContent = 'Todavía no hay palmarés cargado.';
      loading.className = 'state-msg empty';
      return;
    }

    seasonLabel.textContent = data[0]?.season ?? '';
    seasonLabel.hidden = false;
    podium.hidden = false;

    for (const entry of data) {
      const spot = document.createElement('div');
      spot.className = `podium-spot podium-spot-${entry.position}`;

      const avatar = document.createElement('div');
      avatar.className = 'podium-avatar';
      avatar.innerHTML = entry.image_url
        ? `<img src="${base}${entry.image_url}" alt="${entry.name}" />`
        : (MEDALS[entry.position] ?? '⚽');
      spot.appendChild(avatar);

      const medal = document.createElement('span');
      medal.className = 'podium-medal';
      medal.textContent = MEDALS[entry.position] ?? '';
      spot.appendChild(medal);

      const name = document.createElement('span');
      name.className = 'podium-name';
      name.textContent = entry.name;
      spot.appendChild(name);

      const block = document.createElement('div');
      block.className = 'podium-block';
      block.textContent = `${entry.position}`;
      spot.appendChild(block);

      podium.appendChild(spot);
    }
  }
</script>
