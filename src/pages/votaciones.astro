---
import Base from '../layouts/Base.astro';
---

<Base title="Votaciones">
  <main class="wrap votaciones">
    <header class="top-bar animate-in">
      <div>
        <p class="hello" id="hello-msg">Hola 👋</p>
        <h1>Encuestas de la liga</h1>
      </div>
      <button id="change-player" class="btn btn-ghost" type="button">Cambiar de jugador</button>
    </header>

    <div id="state-loading" class="state-msg">Cargando encuestas…</div>
    <div id="state-error" class="state-msg error" hidden>
      No se pudo conectar con la base. Revisá tu conexión o probá de nuevo en un rato.
    </div>
    <div id="state-empty" class="state-msg" hidden>
      Todavía no hay encuestas cargadas. ¡Pronto va a haber algo para votar!
    </div>

    <section id="summary-panel" class="summary-panel animate-in" hidden>
      <div class="summary-head">
        <div>
          <h2>Cómo va quedando la liga</h2>
          <p class="summary-sub">La opción que va ganando en cada encuesta, de un vistazo.</p>
        </div>
        <button id="summary-toggle" class="btn btn-ghost btn-small" type="button">Ocultar</button>
      </div>
      <div id="summary-rows" class="summary-rows"></div>
    </section>

    <section id="polls-list" class="polls-list" hidden></section>
  </main>
</Base>

<style>
  .votaciones {
    gap: 1.75rem;
  }

  .top-bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hello {
    color: var(--text-dim);
    margin: 0 0 0.15rem;
    font-size: 0.95rem;
  }

  h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
  }

  .state-msg {
    color: var(--text-dim);
    padding: 2rem 0;
    text-align: center;
  }

  .state-msg.error {
    color: var(--danger);
  }

  .polls-list {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .summary-panel {
    background: linear-gradient(160deg, var(--bg-card), var(--bg-elevated));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow);
  }

  .summary-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .summary-head h2 {
    font-size: 1.15rem;
  }

  .summary-sub {
    color: var(--text-dim);
    font-size: 0.85rem;
    margin: 0.2rem 0 0;
  }

  .btn-small {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .summary-rows {
    display: flex;
    flex-direction: column;
    margin-top: 1.1rem;
  }

  :global(.summary-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0;
    border-top: 1px solid var(--border);
  }

  :global(.summary-row:first-child) {
    border-top: none;
  }

  :global(.summary-row-main) {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  :global(.summary-cat) {
    color: var(--gold);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  :global(.summary-title) {
    font-size: 0.92rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.summary-leader) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    text-align: right;
  }

  :global(.summary-leader-label) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    max-width: 12rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.summary-leader-label.is-empty) {
    color: var(--text-dim);
    font-family: var(--font-body);
    font-weight: 400;
    font-style: italic;
  }

  :global(.summary-leader-pct) {
    color: var(--accent);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    min-width: 2.5rem;
  }

  :global(.category-section) {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    opacity: 0;
    animation: fade-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  :global(.category-head) {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  :global(.category-title) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--gold);
  }

  :global(.category-count) {
    color: var(--text-dim);
    font-size: 0.8rem;
  }

  :global(.category-polls) {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  :global(.poll-card) {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow);
  }

  :global(.poll-head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }

  :global(.poll-title) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
  }

  :global(.poll-desc) {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin: 0.25rem 0 1rem;
  }

  :global(.options) {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  :global(.option-btn) {
    appearance: none;
    width: 100%;
    text-align: left;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    color: var(--text);
    font-family: var(--font-body);
    font-size: 0.95rem;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: border-color 0.18s ease, transform 0.12s ease;
  }

  :global(.option-btn:hover) {
    border-color: var(--accent-dim);
  }

  :global(.option-btn:active) {
    transform: scale(0.985);
  }

  :global(.option-btn.selected) {
    border-color: var(--accent);
  }

  :global(.option-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 1;
    gap: 0.75rem;
  }

  :global(.option-label) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  :global(.option-hint) {
    display: block;
    color: var(--text-dim);
    font-size: 0.78rem;
    line-height: 1.4;
    margin-top: 0.3rem;
    position: relative;
    z-index: 1;
  }

  :global(.option-pct) {
    color: var(--text-dim);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  :global(.option-bar) {
    position: absolute;
    inset: 0;
    width: 0%;
    background: var(--accent-soft);
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 0;
  }

  :global(.option-btn.selected .option-bar) {
    background: rgba(53, 214, 143, 0.22);
  }

  :global(.check) {
    color: var(--accent);
    font-weight: 700;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { getStoredPlayer, clearStoredPlayer } from '../lib/identity';

  const base = import.meta.env.BASE_URL;

  const player = getStoredPlayer();
  if (!player) {
    window.location.href = `${base}identidad`;
  } else {
    document.getElementById('hello-msg')!.textContent = `Hola, ${player.emoji} ${player.name}`;
    document.getElementById('change-player')!.addEventListener('click', () => {
      clearStoredPlayer();
      window.location.href = `${base}identidad`;
    });
    init(player);
  }

  async function init(player: { id: string; name: string; emoji: string }) {
    const loading = document.getElementById('state-loading')!;
    const errorMsg = document.getElementById('state-error')!;
    const empty = document.getElementById('state-empty')!;
    const list = document.getElementById('polls-list')!;

    const { data: polls, error: pollsError } = await supabase
      .from('polls')
      .select('id, title, description, status, category, created_at, poll_options(id, label, hint, sort_order)')
      .order('created_at', { ascending: true })
      .order('sort_order', { foreignTable: 'poll_options', ascending: true });

    if (pollsError || !polls) {
      loading.hidden = true;
      errorMsg.hidden = false;
      return;
    }

    if (polls.length === 0) {
      loading.hidden = true;
      empty.hidden = false;
      return;
    }

    const { data: votes, error: votesError } = await supabase
      .from('votes')
      .select('id, poll_id, option_id, player_id');

    loading.hidden = true;

    if (votesError) {
      errorMsg.hidden = false;
      return;
    }

    list.hidden = false;
    renderSummary(polls, votes ?? []);

    const CATEGORY_ORDER = ['Liga', 'Participantes', 'Alineaciones', 'Mercado', 'Primas', 'Premium'];
    const categories = new Map<string, any[]>();
    for (const poll of polls) {
      const key = poll.category ?? 'Otras';
      if (!categories.has(key)) categories.set(key, []);
      categories.get(key)!.push(poll);
    }

    const orderedKeys = [...categories.keys()].sort((a, b) => {
      const ia = CATEGORY_ORDER.indexOf(a);
      const ib = CATEGORY_ORDER.indexOf(b);
      if (ia === -1 && ib === -1) return a.localeCompare(b);
      if (ia === -1) return 1;
      if (ib === -1) return -1;
      return ia - ib;
    });

    orderedKeys.forEach((key, i) => {
      const pollsInCategory = categories.get(key)!;
      const section = document.createElement('section');
      section.className = 'category-section';
      section.style.animationDelay = `${i * 0.06}s`;

      const head = document.createElement('div');
      head.className = 'category-head';
      head.innerHTML = `
        <span class="category-title">${key}</span>
        <span class="category-count">${pollsInCategory.length} ${pollsInCategory.length === 1 ? 'encuesta' : 'encuestas'}</span>
      `;
      section.appendChild(head);

      const pollsWrap = document.createElement('div');
      pollsWrap.className = 'category-polls';
      for (const poll of pollsInCategory) {
        pollsWrap.appendChild(renderPoll(poll, votes ?? [], player));
      }
      section.appendChild(pollsWrap);

      list.appendChild(section);
    });
  }

  function renderPoll(poll: any, allVotes: any[], player: { id: string; name: string; emoji: string }) {
    const pollVotes = allVotes.filter((v) => v.poll_id === poll.id);
    const totalVotes = pollVotes.length;
    const myVote = pollVotes.find((v) => v.player_id === player.id);
    const isOpen = poll.status === 'open';

    const card = document.createElement('article');
    card.className = 'poll-card';

    const head = document.createElement('div');
    head.className = 'poll-head';
    head.innerHTML = `
      <span class="poll-title">${poll.title}</span>
      <span class="badge ${isOpen ? '' : 'badge-closed'}">${isOpen ? 'Abierta' : 'Cerrada'}</span>
    `;
    card.appendChild(head);

    if (poll.description) {
      const desc = document.createElement('p');
      desc.className = 'poll-desc';
      desc.textContent = poll.description;
      card.appendChild(desc);
    }

    const options = document.createElement('div');
    options.className = 'options';

    const options_sorted = [...(poll.poll_options ?? [])].sort((a, b) => a.sort_order - b.sort_order);

    for (const option of options_sorted) {
      const count = pollVotes.filter((v) => v.option_id === option.id).length;
      const pct = totalVotes > 0 ? Math.round((count / totalVotes) * 100) : 0;
      const isMine = myVote?.option_id === option.id;

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `option-btn${isMine ? ' selected' : ''}`;
      btn.disabled = !isOpen;
      btn.innerHTML = `
        <span class="option-bar"></span>
        <span class="option-row">
          <span class="option-label">${isMine ? '<span class="check">✓</span>' : ''}${option.label}</span>
          <span class="option-pct">${pct}% · ${count}</span>
        </span>
        ${option.hint ? `<span class="option-hint">${option.hint}</span>` : ''}
      `;

      if (isOpen) {
        btn.addEventListener('click', async () => {
          btn.disabled = true;
          const { error } = await supabase
            .from('votes')
            .upsert(
              { poll_id: poll.id, option_id: option.id, player_id: player.id },
              { onConflict: 'poll_id,player_id' }
            );
          if (!error) {
            const updatedVotes = pollVotes.filter((v) => v.player_id !== player.id);
            updatedVotes.push({ poll_id: poll.id, option_id: option.id, player_id: player.id });
            const newCard = renderPoll(
              { ...poll },
              [...allVotes.filter((v) => v.poll_id !== poll.id), ...updatedVotes],
              player
            );
            card.replaceWith(newCard);
          } else {
            btn.disabled = false;
          }
        });
      }

      options.appendChild(btn);

      requestAnimationFrame(() => {
        const bar = btn.querySelector('.option-bar') as HTMLElement;
        if (bar) bar.style.width = `${pct}%`;
      });
    }

    card.appendChild(options);
    return card;
  }

  function renderSummary(polls: any[], allVotes: any[]) {
    const panel = document.getElementById('summary-panel')!;
    const rows = document.getElementById('summary-rows')!;
    const toggle = document.getElementById('summary-toggle')!;

    rows.innerHTML = '';

    const sortedPolls = [...polls].sort((a, b) => a.created_at.localeCompare(b.created_at));

    for (const poll of sortedPolls) {
      const pollVotes = allVotes.filter((v) => v.poll_id === poll.id);
      const options = poll.poll_options ?? [];

      const counts = options.map((opt: any) => ({
        label: opt.label,
        count: pollVotes.filter((v) => v.option_id === opt.id).length,
      }));

      const max = Math.max(0, ...counts.map((c: any) => c.count));
      const leaders = counts.filter((c: any) => c.count === max && max > 0);

      let leaderLabel: string;
      let leaderClass = '';
      let pctText = '';

      if (max === 0) {
        leaderLabel = 'Sin votos aún';
        leaderClass = 'is-empty';
      } else if (leaders.length > 1) {
        leaderLabel = `Empate (${leaders.map((l: any) => l.label).join(' / ')})`;
      } else {
        leaderLabel = leaders[0].label;
        const pct = Math.round((max / pollVotes.length) * 100);
        pctText = `${pct}%`;
      }

      const row = document.createElement('div');
      row.className = 'summary-row';
      row.innerHTML = `
        <div class="summary-row-main">
          <span class="summary-cat">${poll.category ?? 'Otras'}</span>
          <span class="summary-title">${poll.title}</span>
        </div>
        <div class="summary-leader">
          <span class="summary-leader-label ${leaderClass}">${leaderLabel}</span>
          <span class="summary-leader-pct">${pctText}</span>
        </div>
      `;
      rows.appendChild(row);
    }

    panel.hidden = false;

    toggle.addEventListener('click', () => {
      const isHidden = rows.hidden;
      rows.hidden = !isHidden;
      toggle.textContent = isHidden ? 'Ocultar' : 'Mostrar';
    });
  }
</script>
