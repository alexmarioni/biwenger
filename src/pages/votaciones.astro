---
import Base from '../layouts/Base.astro';
---

<Base title="Votaciones">
  <main class="wrap votaciones">
    <header class="top-bar animate-in">
      <div>
        <p class="hello" id="hello-msg">Hola 👋</p>
        <h1>Encuestas de la liga</h1>
      </div>
      <div class="top-actions">
        <button id="change-player" class="btn btn-ghost" type="button">Cambiar de jugador</button>
      </div>
    </header>

    <div id="state-loading" class="state-msg">Cargando encuestas…</div>
    <div id="state-error" class="state-msg error" hidden>
      No se pudo conectar con la base. Revisá tu conexión o probá de nuevo en un rato.
    </div>
    <div id="state-empty" class="state-msg" hidden>
      Todavía no hay encuestas cargadas. ¡Pronto va a haber algo para votar!
    </div>
    <div id="state-all-done" class="state-msg all-done" hidden>
      🎉 ¡Votaste todo lo que está abierto! Mirá cómo va quedando la liga en <a href={`${import.meta.env.BASE_URL}resultados`}>resultados</a>.
    </div>

    <section id="pending-list" class="polls-list" hidden></section>

    <details id="done-section" class="done-section" hidden>
      <summary class="done-summary">
        <span class="done-summary-title">Ya votaste / cerradas</span>
        <span class="category-count" id="done-count"></span>
      </summary>
      <div id="done-list" class="polls-list done-list"></div>
    </details>
  </main>
</Base>

<style>
  .votaciones {
    gap: 1.75rem;
  }

  .top-bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hello {
    color: var(--text-dim);
    margin: 0 0 0.15rem;
    font-size: 0.95rem;
  }

  h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
  }

  .state-msg {
    color: var(--text-dim);
    padding: 2rem 0;
    text-align: center;
  }

  .state-msg.error {
    color: var(--danger);
  }

  .state-msg.all-done {
    color: var(--text);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .state-msg.all-done a {
    color: var(--accent);
    font-weight: 600;
  }

  .polls-list {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .top-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .done-section {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.25rem 1.25rem;
  }

  .done-summary {
    list-style: none;
    cursor: pointer;
    padding: 1rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    color: var(--text-dim);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .done-summary::-webkit-details-marker {
    display: none;
  }

  .done-summary::before {
    content: '▸';
    margin-right: 0.5rem;
    transition: transform 0.15s ease;
    display: inline-block;
  }

  .done-section[open] .done-summary::before {
    transform: rotate(90deg);
  }

  .done-list {
    padding: 0.5rem 0 1.25rem;
  }

  :global(.category-section) {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    opacity: 0;
    animation: fade-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  :global(.category-head) {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  :global(.category-title) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--gold);
  }

  :global(.category-count) {
    color: var(--text-dim);
    font-size: 0.8rem;
  }

  :global(.category-polls) {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { getStoredPlayer, clearStoredPlayer } from '../lib/identity';
  import { redirectIfMaintenance } from '../lib/maintenance';
  import { renderPollCard } from '../lib/pollCard';
  import { playerAvatarHtml } from '../lib/playerAvatar';

  const base = import.meta.env.BASE_URL;

  document.addEventListener('astro:page-load', start);

  async function start() {
    if (await redirectIfMaintenance(base)) return;

    const player = getStoredPlayer();
    if (!player) {
      window.location.href = `${base}identidad`;
    } else {
      document.getElementById('hello-msg')!.innerHTML = `Hola, ${playerAvatarHtml(player, base)} ${player.name}`;
      document.getElementById('change-player')!.addEventListener('click', () => {
        clearStoredPlayer();
        window.location.href = `${base}identidad`;
      });
      init(player);
    }
  }

  const CATEGORY_ORDER = ['Liga', 'Participantes', 'Alineaciones', 'Mercado', 'Primas', 'Premium'];

  let allPolls: any[] = [];
  let allVotesState: any[] = [];

  async function init(player: { id: string; name: string; emoji: string }) {
    const loading = document.getElementById('state-loading')!;
    const errorMsg = document.getElementById('state-error')!;
    const empty = document.getElementById('state-empty')!;

    const { data: polls, error: pollsError } = await supabase
      .from('polls')
      .select('id, title, description, status, poll_type, category, created_at, featured, placeholder, min_value, max_value, allow_empty, empty_label, poll_options(id, label, hint, sort_order)')
      .order('created_at', { ascending: true })
      .order('sort_order', { foreignTable: 'poll_options', ascending: true });

    if (pollsError || !polls) {
      loading.hidden = true;
      errorMsg.hidden = false;
      return;
    }

    if (polls.length === 0) {
      loading.hidden = true;
      empty.hidden = false;
      return;
    }

    const { data: votes, error: votesError } = await supabase
      .from('votes')
      .select('id, poll_id, option_id, text_value, player_id');

    loading.hidden = true;

    if (votesError) {
      errorMsg.hidden = false;
      return;
    }

    // Las encuestas "featured" tienen su propio widget fijo aparte (home) y
    // no se mezclan acá.
    allPolls = polls.filter((p) => !p.featured && p.category !== 'Minijuegos' && p.category !== 'Jornada');
    allVotesState = votes ?? [];

    renderAll(player);
  }

  function renderAll(player: { id: string; name: string; emoji: string }) {
    const pendingList = document.getElementById('pending-list')!;
    const doneSection = document.getElementById('done-section')! as HTMLDetailsElement;
    const doneList = document.getElementById('done-list')!;
    const doneCount = document.getElementById('done-count')!;
    const allDoneMsg = document.getElementById('state-all-done')!;

    pendingList.innerHTML = '';
    doneList.innerHTML = '';

    const pending: any[] = [];
    const done: any[] = [];

    for (const poll of allPolls) {
      const isOpen = poll.status === 'open';
      const myVote = allVotesState.find((v) => v.poll_id === poll.id && v.player_id === player.id);
      if (isOpen && !myVote) {
        pending.push(poll);
      } else {
        done.push(poll);
      }
    }

    if (pending.length > 0) {
      pendingList.hidden = false;
      allDoneMsg.hidden = true;
      renderCategoryGroups(pendingList, pending, player);
    } else {
      pendingList.hidden = true;
      allDoneMsg.hidden = false;
    }

    if (done.length > 0) {
      doneSection.hidden = false;
      doneCount.textContent = `${done.length}`;
      renderCategoryGroups(doneList, done, player);
    } else {
      doneSection.hidden = true;
    }
  }

  function renderCategoryGroups(container: HTMLElement, polls: any[], player: { id: string; name: string; emoji: string }) {
    const categories = new Map<string, any[]>();
    for (const poll of polls) {
      const key = poll.category ?? 'Otras';
      if (!categories.has(key)) categories.set(key, []);
      categories.get(key)!.push(poll);
    }

    const orderedKeys = [...categories.keys()].sort((a, b) => {
      const ia = CATEGORY_ORDER.indexOf(a);
      const ib = CATEGORY_ORDER.indexOf(b);
      if (ia === -1 && ib === -1) return a.localeCompare(b);
      if (ia === -1) return 1;
      if (ib === -1) return -1;
      return ia - ib;
    });

    orderedKeys.forEach((key, i) => {
      const pollsInCategory = categories.get(key)!;
      const section = document.createElement('section');
      section.className = 'category-section';
      section.style.animationDelay = `${i * 0.06}s`;

      const head = document.createElement('div');
      head.className = 'category-head';
      head.innerHTML = `
        <span class="category-title">${key}</span>
        <span class="category-count">${pollsInCategory.length} ${pollsInCategory.length === 1 ? 'encuesta' : 'encuestas'}</span>
      `;
      section.appendChild(head);

      const pollsWrap = document.createElement('div');
      pollsWrap.className = 'category-polls';
      for (const poll of pollsInCategory) {
        pollsWrap.appendChild(
          renderPollCard(poll, allVotesState, player, (updated) => {
            allVotesState = updated;
          })
        );
      }
      section.appendChild(pollsWrap);

      container.appendChild(section);
    });
  }
</script>
