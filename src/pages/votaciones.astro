---
import Base from '../layouts/Base.astro';
---

<Base title="Votaciones">
  <main class="wrap votaciones">
    <header class="top-bar animate-in">
      <div>
        <p class="hello" id="hello-msg">Hola 👋</p>
        <h1>Encuestas de la liga</h1>
      </div>
      <div class="top-actions">
        <a class="btn btn-ghost" href={`${import.meta.env.BASE_URL}resultados`}>Ver resultados</a>
        <a class="btn btn-ghost" href={`${import.meta.env.BASE_URL}palmares`}>🏆 Palmarés</a>
        <button id="change-player" class="btn btn-ghost" type="button">Cambiar de jugador</button>
      </div>
    </header>

    <div id="state-loading" class="state-msg">Cargando encuestas…</div>
    <div id="state-error" class="state-msg error" hidden>
      No se pudo conectar con la base. Revisá tu conexión o probá de nuevo en un rato.
    </div>
    <div id="state-empty" class="state-msg" hidden>
      Todavía no hay encuestas cargadas. ¡Pronto va a haber algo para votar!
    </div>
    <div id="state-all-done" class="state-msg all-done" hidden>
      🎉 ¡Votaste todo lo que está abierto! Mirá cómo va quedando la liga en <a href={`${import.meta.env.BASE_URL}resultados`}>resultados</a>.
    </div>

    <section id="pending-list" class="polls-list" hidden></section>

    <details id="done-section" class="done-section" hidden>
      <summary class="done-summary">
        <span class="done-summary-title">Ya votaste / cerradas</span>
        <span class="category-count" id="done-count"></span>
      </summary>
      <div id="done-list" class="polls-list done-list"></div>
    </details>
  </main>
</Base>

<style>
  .votaciones {
    gap: 1.75rem;
  }

  .top-bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hello {
    color: var(--text-dim);
    margin: 0 0 0.15rem;
    font-size: 0.95rem;
  }

  h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
  }

  .state-msg {
    color: var(--text-dim);
    padding: 2rem 0;
    text-align: center;
  }

  .state-msg.error {
    color: var(--danger);
  }

  .state-msg.all-done {
    color: var(--text);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .state-msg.all-done a {
    color: var(--accent);
    text-decoration: underline;
  }

  .polls-list {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .top-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .done-section {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.25rem 1.25rem;
  }

  .done-summary {
    list-style: none;
    cursor: pointer;
    padding: 1rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    color: var(--text-dim);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .done-summary::-webkit-details-marker {
    display: none;
  }

  .done-summary::before {
    content: '▸';
    margin-right: 0.5rem;
    transition: transform 0.15s ease;
    display: inline-block;
  }

  .done-section[open] .done-summary::before {
    transform: rotate(90deg);
  }

  .done-list {
    padding: 0.5rem 0 1.25rem;
  }

  :global(.category-section) {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    opacity: 0;
    animation: fade-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  :global(.category-head) {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  :global(.category-title) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--gold);
  }

  :global(.category-count) {
    color: var(--text-dim);
    font-size: 0.8rem;
  }

  :global(.category-polls) {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  :global(.poll-card) {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow);
  }

  :global(.poll-head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }

  :global(.poll-title) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
  }

  :global(.poll-badges) {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  :global(.poll-desc) {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin: 0.25rem 0 1rem;
  }

  :global(.options) {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  :global(.option-btn) {
    appearance: none;
    width: 100%;
    text-align: left;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    color: var(--text);
    font-family: var(--font-body);
    font-size: 0.95rem;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: border-color 0.18s ease, transform 0.12s ease;
  }

  :global(.option-btn:hover) {
    border-color: var(--accent-dim);
  }

  :global(.option-btn:active) {
    transform: scale(0.985);
  }

  :global(.option-btn.selected) {
    border-color: var(--accent);
  }

  :global(.option-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 1;
    gap: 0.75rem;
  }

  :global(.option-label) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  :global(.option-hint) {
    display: block;
    color: var(--text-dim);
    font-size: 0.78rem;
    line-height: 1.4;
    margin-top: 0.3rem;
    position: relative;
    z-index: 1;
  }

  :global(.option-pct) {
    color: var(--text-dim);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  :global(.option-bar) {
    position: absolute;
    inset: 0;
    width: 0%;
    background: var(--accent-soft);
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 0;
  }

  :global(.option-btn.selected .option-bar) {
    background: rgba(53, 214, 143, 0.22);
  }

  :global(.check) {
    color: var(--accent);
    font-weight: 700;
  }

  :global(.btn-small) {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  :global(.text-answer-form) {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  :global(.text-answer-input) {
    flex: 1;
    min-width: 10rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    color: var(--text);
    font-family: var(--font-body);
    font-size: 0.95rem;
  }

  :global(.text-answer-input:focus) {
    outline: none;
    border-color: var(--accent-dim);
  }

  :global(.text-answer-note) {
    color: var(--text-dim);
    font-size: 0.8rem;
    margin: 0.6rem 0 0;
  }

  :global(.text-answer-error) {
    color: var(--danger);
    font-size: 0.82rem;
    margin: 0.5rem 0 0;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { getStoredPlayer, clearStoredPlayer } from '../lib/identity';
  import { redirectIfMaintenance } from '../lib/maintenance';

  const base = import.meta.env.BASE_URL;

  start();

  async function start() {
    if (await redirectIfMaintenance(base)) return;

    const player = getStoredPlayer();
    if (!player) {
      window.location.href = `${base}identidad`;
    } else {
      document.getElementById('hello-msg')!.textContent = `Hola, ${player.emoji} ${player.name}`;
      document.getElementById('change-player')!.addEventListener('click', () => {
        clearStoredPlayer();
        window.location.href = `${base}identidad`;
      });
      init(player);
    }
  }

  const CATEGORY_ORDER = ['Liga', 'Participantes', 'Alineaciones', 'Mercado', 'Primas', 'Premium'];

  let allPolls: any[] = [];
  let allVotesState: any[] = [];

  async function init(player: { id: string; name: string; emoji: string }) {
    const loading = document.getElementById('state-loading')!;
    const errorMsg = document.getElementById('state-error')!;
    const empty = document.getElementById('state-empty')!;

    const { data: polls, error: pollsError } = await supabase
      .from('polls')
      .select('id, title, description, status, poll_type, category, created_at, placeholder, min_value, max_value, allow_empty, empty_label, poll_options(id, label, hint, sort_order)')
      .order('created_at', { ascending: true })
      .order('sort_order', { foreignTable: 'poll_options', ascending: true });

    if (pollsError || !polls) {
      loading.hidden = true;
      errorMsg.hidden = false;
      return;
    }

    if (polls.length === 0) {
      loading.hidden = true;
      empty.hidden = false;
      return;
    }

    const { data: votes, error: votesError } = await supabase
      .from('votes')
      .select('id, poll_id, option_id, text_value, player_id');

    loading.hidden = true;

    if (votesError) {
      errorMsg.hidden = false;
      return;
    }

    allPolls = polls;
    allVotesState = votes ?? [];

    renderAll(player);
  }

  function renderAll(player: { id: string; name: string; emoji: string }) {
    const pendingList = document.getElementById('pending-list')!;
    const doneSection = document.getElementById('done-section')! as HTMLDetailsElement;
    const doneList = document.getElementById('done-list')!;
    const doneCount = document.getElementById('done-count')!;
    const allDoneMsg = document.getElementById('state-all-done')!;

    pendingList.innerHTML = '';
    doneList.innerHTML = '';

    const pending: any[] = [];
    const done: any[] = [];

    for (const poll of allPolls) {
      const isOpen = poll.status === 'open';
      const myVote = allVotesState.find((v) => v.poll_id === poll.id && v.player_id === player.id);
      if (isOpen && !myVote) {
        pending.push(poll);
      } else {
        done.push(poll);
      }
    }

    if (pending.length > 0) {
      pendingList.hidden = false;
      allDoneMsg.hidden = true;
      renderCategoryGroups(pendingList, pending, player);
    } else {
      pendingList.hidden = true;
      allDoneMsg.hidden = false;
    }

    if (done.length > 0) {
      doneSection.hidden = false;
      doneCount.textContent = `${done.length}`;
      renderCategoryGroups(doneList, done, player);
    } else {
      doneSection.hidden = true;
    }
  }

  function renderCategoryGroups(container: HTMLElement, polls: any[], player: { id: string; name: string; emoji: string }) {
    const categories = new Map<string, any[]>();
    for (const poll of polls) {
      const key = poll.category ?? 'Otras';
      if (!categories.has(key)) categories.set(key, []);
      categories.get(key)!.push(poll);
    }

    const orderedKeys = [...categories.keys()].sort((a, b) => {
      const ia = CATEGORY_ORDER.indexOf(a);
      const ib = CATEGORY_ORDER.indexOf(b);
      if (ia === -1 && ib === -1) return a.localeCompare(b);
      if (ia === -1) return 1;
      if (ib === -1) return -1;
      return ia - ib;
    });

    orderedKeys.forEach((key, i) => {
      const pollsInCategory = categories.get(key)!;
      const section = document.createElement('section');
      section.className = 'category-section';
      section.style.animationDelay = `${i * 0.06}s`;

      const head = document.createElement('div');
      head.className = 'category-head';
      head.innerHTML = `
        <span class="category-title">${key}</span>
        <span class="category-count">${pollsInCategory.length} ${pollsInCategory.length === 1 ? 'encuesta' : 'encuestas'}</span>
      `;
      section.appendChild(head);

      const pollsWrap = document.createElement('div');
      pollsWrap.className = 'category-polls';
      for (const poll of pollsInCategory) {
        pollsWrap.appendChild(renderPoll(poll, allVotesState, player));
      }
      section.appendChild(pollsWrap);

      container.appendChild(section);
    });
  }

  function renderPoll(poll: any, allVotes: any[], player: { id: string; name: string; emoji: string }) {
    const pollVotes = allVotes.filter((v) => v.poll_id === poll.id);
    const totalVotes = pollVotes.length;
    const isMulti = poll.poll_type === 'multi';
    const myOptionIds = new Set(
      pollVotes.filter((v) => v.player_id === player.id).map((v) => v.option_id)
    );
    const isOpen = poll.status === 'open';

    const card = document.createElement('article');
    card.className = 'poll-card';

    const head = document.createElement('div');
    head.className = 'poll-head';
    head.innerHTML = `
      <span class="poll-title">${poll.title}</span>
      <span class="poll-badges">
        ${isMulti ? '<span class="badge">Elegí varias</span>' : ''}
        <span class="badge ${isOpen ? '' : 'badge-closed'}">${isOpen ? 'Abierta' : 'Cerrada'}</span>
      </span>
    `;
    card.appendChild(head);

    if (poll.description) {
      const desc = document.createElement('p');
      desc.className = 'poll-desc';
      desc.textContent = poll.description;
      card.appendChild(desc);
    }

    if (poll.poll_type === 'text') {
      renderTextAnswer(card, poll, pollVotes, isOpen, player);
      return card;
    }

    const options = document.createElement('div');
    options.className = 'options';

    const options_sorted = [...(poll.poll_options ?? [])].sort((a, b) => a.sort_order - b.sort_order);

    for (const option of options_sorted) {
      const count = pollVotes.filter((v) => v.option_id === option.id).length;
      const pct = totalVotes > 0 ? Math.round((count / totalVotes) * 100) : 0;
      const isMine = myOptionIds.has(option.id);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `option-btn${isMine ? ' selected' : ''}`;
      btn.disabled = !isOpen;
      btn.innerHTML = `
        <span class="option-bar"></span>
        <span class="option-row">
          <span class="option-label">${isMine ? '<span class="check">✓</span>' : ''}${option.label}</span>
          <span class="option-pct">${pct}% · ${count}</span>
        </span>
        ${option.hint ? `<span class="option-hint">${option.hint}</span>` : ''}
      `;

      if (isOpen) {
        btn.addEventListener('click', async () => {
          btn.disabled = true;

          if (isMulti) {
            if (isMine) {
              const { error } = await supabase
                .from('votes')
                .delete()
                .eq('poll_id', poll.id)
                .eq('option_id', option.id)
                .eq('player_id', player.id);
              if (!error) {
                allVotesState = allVotesState.filter(
                  (v) => !(v.poll_id === poll.id && v.option_id === option.id && v.player_id === player.id)
                );
                card.replaceWith(renderPoll(poll, allVotesState, player));
                return;
              }
            } else {
              const { error } = await supabase
                .from('votes')
                .insert({ poll_id: poll.id, option_id: option.id, player_id: player.id });
              if (!error) {
                allVotesState = [
                  ...allVotesState,
                  { poll_id: poll.id, option_id: option.id, player_id: player.id },
                ];
                card.replaceWith(renderPoll(poll, allVotesState, player));
                return;
              }
            }
          } else {
            await supabase.from('votes').delete().eq('poll_id', poll.id).eq('player_id', player.id);
            const { error } = await supabase
              .from('votes')
              .insert({ poll_id: poll.id, option_id: option.id, player_id: player.id });
            if (!error) {
              allVotesState = [
                ...allVotesState.filter((v) => !(v.poll_id === poll.id && v.player_id === player.id)),
                { poll_id: poll.id, option_id: option.id, player_id: player.id },
              ];
              card.replaceWith(renderPoll(poll, allVotesState, player));
              return;
            }
          }

          btn.disabled = false;
        });
      }

      options.appendChild(btn);

      requestAnimationFrame(() => {
        const bar = btn.querySelector('.option-bar') as HTMLElement;
        if (bar) bar.style.width = `${pct}%`;
      });
    }

    card.appendChild(options);
    return card;
  }

  function renderTextAnswer(
    card: HTMLElement,
    poll: any,
    pollVotes: any[],
    isOpen: boolean,
    player: { id: string; name: string; emoji: string }
  ) {
    const myVote = pollVotes.find((v) => v.player_id === player.id);
    const answeredCount = pollVotes.length;

    const form = document.createElement('form');
    form.className = 'text-answer-form';

    const input = document.createElement('input');
    input.type = 'text';
    input.className = 'text-answer-input';
    input.placeholder = poll.placeholder ?? (poll.allow_empty ? `Dejalo vacío para "${poll.empty_label ?? 'sin especificar'}"` : 'Escribí tu respuesta');
    input.value = myVote?.text_value ?? '';
    input.disabled = !isOpen;

    const submit = document.createElement('button');
    submit.type = 'submit';
    submit.className = 'btn btn-primary btn-small';
    submit.textContent = myVote ? 'Actualizar' : 'Guardar';
    submit.disabled = !isOpen;

    form.appendChild(input);
    form.appendChild(submit);
    card.appendChild(form);

    const errorMsg = document.createElement('p');
    errorMsg.className = 'text-answer-error';
    errorMsg.hidden = true;
    card.appendChild(errorMsg);

    const hints: string[] = [];
    if (poll.min_value != null || poll.max_value != null) {
      if (poll.min_value != null && poll.max_value != null) {
        hints.push(`Un número entre ${poll.min_value} y ${poll.max_value}.`);
      } else if (poll.min_value != null) {
        hints.push(`Un número desde ${poll.min_value}.`);
      } else {
        hints.push(`Un número hasta ${poll.max_value}.`);
      }
    }
    if (poll.allow_empty) {
      hints.push(`Vacío cuenta como "${poll.empty_label ?? 'sin especificar'}".`);
    }
    hints.push(`${answeredCount} ${answeredCount === 1 ? 'persona respondió' : 'personas respondieron'} hasta ahora.`);

    const note = document.createElement('p');
    note.className = 'text-answer-note';
    note.textContent = hints.join(' ');
    card.appendChild(note);

    if (isOpen) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorMsg.hidden = true;
        const value = input.value.trim();

        if (!value) {
          if (!poll.allow_empty) {
            errorMsg.textContent = 'Este campo no puede quedar vacío.';
            errorMsg.hidden = false;
            return;
          }
        } else if (poll.min_value != null || poll.max_value != null) {
          const num = Number(value);
          if (
            Number.isNaN(num) ||
            (poll.min_value != null && num < poll.min_value) ||
            (poll.max_value != null && num > poll.max_value)
          ) {
            errorMsg.textContent =
              poll.min_value != null && poll.max_value != null
                ? `Tiene que ser un número entre ${poll.min_value} y ${poll.max_value}.`
                : 'Tiene que ser un número válido.';
            errorMsg.hidden = false;
            return;
          }
        }

        input.disabled = true;
        submit.disabled = true;

        await supabase.from('votes').delete().eq('poll_id', poll.id).eq('player_id', player.id);
        const { error } = await supabase
          .from('votes')
          .insert({ poll_id: poll.id, player_id: player.id, text_value: value });

        if (!error) {
          allVotesState = [
            ...allVotesState.filter((v) => !(v.poll_id === poll.id && v.player_id === player.id)),
            { poll_id: poll.id, option_id: null, text_value: value, player_id: player.id },
          ];
          card.replaceWith(renderPoll(poll, allVotesState, player));
        } else {
          input.disabled = false;
          submit.disabled = false;
        }
      });
    }
  }
</script>
