---
import Base from '../layouts/Base.astro';
---

<Base title="Resultados">
  <main class="wrap resultados">
    <header class="top-bar animate-in">
      <div>
        <p class="hello" id="hello-msg">Hola 👋</p>
        <h1>Resultados</h1>
      </div>
      <div class="top-actions">
        <a class="btn btn-ghost" href={`${import.meta.env.BASE_URL}votaciones`}>Volver a votar</a>
        <button id="change-player" class="btn btn-ghost" type="button">Cambiar de jugador</button>
      </div>
    </header>

    <div id="state-loading" class="state-msg">Cargando resultados…</div>
    <div id="state-error" class="state-msg error" hidden>
      No se pudo conectar con la base. Revisá tu conexión o probá de nuevo en un rato.
    </div>

    <section id="players-section" class="block" hidden>
      <h2>Quién votó qué</h2>
      <p class="block-sub">Tocá un nombre para ver todo lo que votó.</p>
      <div id="players-list" class="players-list stagger"></div>
    </section>

    <section id="summary-panel" class="block summary-panel" hidden>
      <div class="summary-head">
        <div>
          <h2>Cómo va quedando la liga</h2>
          <p class="block-sub">La opción que va ganando en cada encuesta, de un vistazo.</p>
        </div>
        <button id="summary-toggle" class="btn btn-ghost btn-small" type="button">Ocultar</button>
      </div>
      <div id="summary-rows" class="summary-rows"></div>
    </section>
  </main>
</Base>

<style>
  .resultados {
    gap: 2.5rem;
  }

  .top-bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .top-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .hello {
    color: var(--text-dim);
    margin: 0 0 0.15rem;
    font-size: 0.95rem;
  }

  h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
  }

  .block h2 {
    font-size: 1.15rem;
  }

  .block-sub {
    color: var(--text-dim);
    font-size: 0.85rem;
    margin: 0.2rem 0 0;
  }

  .state-msg {
    color: var(--text-dim);
    padding: 2rem 0;
    text-align: center;
  }

  .state-msg.error {
    color: var(--danger);
  }

  .players-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.1rem;
  }

  :global(.player-card) {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  :global(.player-summary) {
    list-style: none;
    cursor: pointer;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  :global(.player-summary::-webkit-details-marker) {
    display: none;
  }

  :global(.player-name) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 600;
  }

  :global(.player-progress) {
    color: var(--text-dim);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  :global(.player-votes) {
    padding: 0 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  :global(.player-cat-title) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--gold);
    margin-bottom: 0.5rem;
    display: block;
  }

  :global(.player-vote-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0;
    border-top: 1px solid var(--border);
    font-size: 0.88rem;
  }

  :global(.player-vote-row:first-of-type) {
    border-top: none;
  }

  :global(.player-vote-poll) {
    color: var(--text-dim);
  }

  :global(.player-vote-answer) {
    font-weight: 600;
    text-align: right;
  }

  :global(.player-vote-answer.is-empty) {
    color: var(--text-dim);
    font-weight: 400;
    font-style: italic;
  }

  .summary-panel {
    background: linear-gradient(160deg, var(--bg-card), var(--bg-elevated));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow);
  }

  .summary-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .btn-small {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .summary-rows {
    display: flex;
    flex-direction: column;
    margin-top: 1.1rem;
  }

  :global(.summary-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0;
    border-top: 1px solid var(--border);
  }

  :global(.summary-row:first-child) {
    border-top: none;
  }

  :global(.summary-row-main) {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  :global(.summary-cat) {
    color: var(--gold);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  :global(.summary-title) {
    font-size: 0.92rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.summary-leader) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    text-align: right;
  }

  :global(.summary-leader-label) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    max-width: 12rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.summary-leader-label.is-empty) {
    color: var(--text-dim);
    font-family: var(--font-body);
    font-weight: 400;
    font-style: italic;
  }

  :global(.summary-leader-pct) {
    color: var(--accent);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    min-width: 2.5rem;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { getStoredPlayer, clearStoredPlayer } from '../lib/identity';
  import { redirectIfMaintenance } from '../lib/maintenance';

  const base = import.meta.env.BASE_URL;

  start();

  async function start() {
    if (await redirectIfMaintenance(base)) return;

    const player = getStoredPlayer();
    if (!player) {
      window.location.href = `${base}identidad`;
    } else {
      document.getElementById('hello-msg')!.textContent = `Hola, ${player.emoji} ${player.name}`;
      document.getElementById('change-player')!.addEventListener('click', () => {
        clearStoredPlayer();
        window.location.href = `${base}identidad`;
      });
      init();
    }
  }

  const CATEGORY_ORDER = ['Liga', 'Participantes', 'Alineaciones', 'Mercado', 'Primas', 'Premium'];

  function sortByCategory<T extends { category: string | null }>(items: T[]): T[] {
    return [...items].sort((a, b) => {
      const ka = a.category ?? 'Otras';
      const kb = b.category ?? 'Otras';
      const ia = CATEGORY_ORDER.indexOf(ka);
      const ib = CATEGORY_ORDER.indexOf(kb);
      if (ia === -1 && ib === -1) return ka.localeCompare(kb);
      if (ia === -1) return 1;
      if (ib === -1) return -1;
      return ia - ib;
    });
  }

  async function init() {
    const loading = document.getElementById('state-loading')!;
    const errorMsg = document.getElementById('state-error')!;

    const [playersRes, pollsRes, votesRes] = await Promise.all([
      supabase.from('players').select('id, name, emoji').order('name', { ascending: true }),
      supabase
        .from('polls')
        .select('id, title, status, poll_type, category, created_at, poll_options(id, label, sort_order)')
        .order('sort_order', { foreignTable: 'poll_options', ascending: true }),
      supabase.from('votes').select('id, poll_id, option_id, text_value, player_id'),
    ]);

    if (playersRes.error || pollsRes.error || votesRes.error) {
      loading.hidden = true;
      errorMsg.hidden = false;
      return;
    }

    const players = playersRes.data ?? [];
    const polls = sortByCategory(pollsRes.data ?? []);
    const votes = votesRes.data ?? [];

    loading.hidden = true;

    renderPlayers(players, polls, votes);
    renderSummary(polls, votes);
  }

  function renderPlayers(players: any[], polls: any[], votes: any[]) {
    const section = document.getElementById('players-section')!;
    const list = document.getElementById('players-list')!;
    list.innerHTML = '';

    for (const p of players) {
      const myVotes = votes.filter((v) => v.player_id === p.id);
      const pollsAnswered = new Set(myVotes.map((v) => v.poll_id)).size;

      const details = document.createElement('details');
      details.className = 'player-card';

      const summary = document.createElement('summary');
      summary.className = 'player-summary';
      summary.innerHTML = `
        <span class="player-name">${p.emoji} ${p.name}</span>
        <span class="player-progress">${pollsAnswered}/${polls.length} votos</span>
      `;
      details.appendChild(summary);

      const votesWrap = document.createElement('div');
      votesWrap.className = 'player-votes';

      let currentCategory = '';
      let catGroup: HTMLDivElement | null = null;

      for (const poll of polls) {
        const category = poll.category ?? 'Otras';
        if (category !== currentCategory) {
          currentCategory = category;
          catGroup = document.createElement('div');
          const title = document.createElement('span');
          title.className = 'player-cat-title';
          title.textContent = category;
          catGroup.appendChild(title);
          votesWrap.appendChild(catGroup);
        }

        const myPollVotes = myVotes.filter((v) => v.poll_id === poll.id);
        let answerText: string;
        let hasAnswer: boolean;

        if (poll.poll_type === 'text') {
          const textVote = myPollVotes[0];
          hasAnswer = !!textVote?.text_value;
          answerText = hasAnswer ? textVote.text_value : 'Sin votar';
        } else {
          const chosenOptions = myPollVotes
            .map((v) => (poll.poll_options ?? []).find((o: any) => o.id === v.option_id))
            .filter(Boolean);
          hasAnswer = chosenOptions.length > 0;
          answerText = hasAnswer ? chosenOptions.map((o: any) => o.label).join(', ') : 'Sin votar';
        }

        const row = document.createElement('div');
        row.className = 'player-vote-row';
        row.innerHTML = `
          <span class="player-vote-poll">${poll.title}</span>
          <span class="player-vote-answer${hasAnswer ? '' : ' is-empty'}">${answerText}</span>
        `;
        catGroup!.appendChild(row);
      }

      details.appendChild(votesWrap);
      list.appendChild(details);
    }

    section.hidden = false;
  }

  function renderSummary(polls: any[], allVotes: any[]) {
    const panel = document.getElementById('summary-panel')!;
    const rows = document.getElementById('summary-rows')!;
    const toggle = document.getElementById('summary-toggle')!;

    rows.innerHTML = '';

    for (const poll of polls) {
      const pollVotes = allVotes.filter((v) => v.poll_id === poll.id);
      const isText = poll.poll_type === 'text';

      let counts: { label: string; count: number }[];
      if (isText) {
        const map = new Map<string, number>();
        for (const v of pollVotes) {
          if (!v.text_value) continue;
          const key = v.text_value.trim();
          map.set(key, (map.get(key) ?? 0) + 1);
        }
        counts = [...map.entries()].map(([label, count]) => ({ label, count }));
      } else {
        const options = poll.poll_options ?? [];
        counts = options.map((opt: any) => ({
          label: opt.label,
          count: pollVotes.filter((v: any) => v.option_id === opt.id).length,
        }));
      }

      const max = Math.max(0, ...counts.map((c) => c.count));
      const leaders = counts.filter((c) => c.count === max && max > 0);

      let leaderLabel: string;
      let leaderClass = '';
      let pctText = '';

      if (max === 0) {
        leaderLabel = 'Sin respuestas aún';
        leaderClass = 'is-empty';
      } else if (leaders.length > 1) {
        const shown = leaders.slice(0, 3).map((l) => l.label);
        const extra = leaders.length > 3 ? ` +${leaders.length - 3} más` : '';
        leaderLabel = isText ? `Varias respuestas (${shown.join(' / ')}${extra})` : `Empate (${shown.join(' / ')}${extra})`;
      } else {
        leaderLabel = leaders[0].label;
        const pct = Math.round((max / pollVotes.length) * 100);
        pctText = `${pct}%`;
      }

      const row = document.createElement('div');
      row.className = 'summary-row';
      row.innerHTML = `
        <div class="summary-row-main">
          <span class="summary-cat">${poll.category ?? 'Otras'}</span>
          <span class="summary-title">${poll.title}</span>
        </div>
        <div class="summary-leader">
          <span class="summary-leader-label ${leaderClass}">${leaderLabel}</span>
          <span class="summary-leader-pct">${pctText}</span>
        </div>
      `;
      rows.appendChild(row);
    }

    panel.hidden = false;

    toggle.addEventListener('click', () => {
      const isHidden = rows.hidden;
      rows.hidden = !isHidden;
      toggle.textContent = isHidden ? 'Ocultar' : 'Mostrar';
    });
  }
</script>
