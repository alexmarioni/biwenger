---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="Bienvenida">
  <main class="wrap hero">
    <div class="hero-content animate-in">
      <span class="badge">⚽ Liga Biwenger</span>
      <h1>Decidamos entre todos<br />cómo se juega esta liga.</h1>
      <p class="lead">
        Balance inicial, modo de juego, reglas especiales... en vez de discutirlo
        en el grupo, lo votamos acá. Elegí quién sos y metele tu voto.
      </p>
      <a class="btn btn-primary" href={`${base}identidad`} data-astro-prefetch>
        Entrar a votar
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="float-shapes" aria-hidden="true">
      <span class="shape shape-1">🏆</span>
      <span class="shape shape-2">⚙️</span>
      <span class="shape shape-3">🗳️</span>
    </div>
  </main>
</Base>

<script>
  import { redirectIfMaintenance } from '../lib/maintenance';

  redirectIfMaintenance(import.meta.env.BASE_URL);
</script>

<style>
  .hero {
    justify-content: center;
    align-items: center;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 30rem;
    z-index: 1;
  }

  h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
  }

  .lead {
    color: var(--text-dim);
    font-size: 1.05rem;
  }

  .float-shapes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .shape {
    position: absolute;
    font-size: 2.5rem;
    opacity: 0.35;
    animation: float 5s ease-in-out infinite;
  }

  .shape-1 { top: 12%; left: 8%; animation-delay: 0s; }
  .shape-2 { top: 65%; right: 10%; animation-delay: 1.2s; }
  .shape-3 { bottom: 8%; left: 18%; animation-delay: 2.1s; }

  @media (max-width: 480px) {
    .shape { font-size: 1.8rem; }
  }
</style>
