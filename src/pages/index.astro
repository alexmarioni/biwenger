---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="Bienvenida">
  <main class="wrap home">
    <div class="hero-content animate-in">
      <span class="badge">⚽ Liga Biwenger</span>
      <h1>Decidamos entre todos cómo se juega esta liga.</h1>
    </div>

    <div id="widgets-loading" class="state-msg">Cargando…</div>
    <div id="widgets-error" class="state-msg error" hidden>
      No se pudo conectar con la base. Revisá tu conexión o probá de nuevo en un rato.
    </div>

    <div id="widgets" class="widgets stagger" hidden>
      <section id="poll-widget" class="widget" hidden>
        <div class="widget-head">
          <span class="widget-title">🗳️ Encuestas</span>
          <a class="widget-link" href={`${base}votaciones`}>Ver todas →</a>
        </div>
        <div class="poll-widget-viewport">
          <div id="poll-widget-body"></div>
        </div>
        <div class="widget-nav">
          <button id="poll-prev" class="widget-nav-btn" type="button" aria-label="Anterior">‹</button>
          <span id="poll-counter" class="widget-counter"></span>
          <button id="poll-next" class="widget-nav-btn" type="button" aria-label="Siguiente">›</button>
        </div>
      </section>

      <section id="results-widget" class="widget" hidden>
        <div class="widget-head">
          <span class="widget-title">📊 Resultados</span>
          <a class="widget-link" href={`${base}resultados`}>Ver todos →</a>
        </div>
        <div id="results-widget-body" class="result-mini"></div>
        <div class="widget-nav">
          <button id="results-prev" class="widget-nav-btn" type="button" aria-label="Anterior">‹</button>
          <span id="results-counter" class="widget-counter"></span>
          <button id="results-next" class="widget-nav-btn" type="button" aria-label="Siguiente">›</button>
        </div>
      </section>

      <section id="palmares-widget" class="widget" hidden>
        <div class="widget-head">
          <span class="widget-title">🏆 Palmarés</span>
          <a class="widget-link" href={`${base}palmares`}>Ver completo →</a>
        </div>
        <div id="palmares-mini" class="palmares-mini"></div>
      </section>

      <section id="participants-widget" class="widget" hidden>
        <div class="widget-head">
          <span class="widget-title">👥 Participantes</span>
          <span class="widget-counter" id="participants-count"></span>
        </div>
        <div id="participants-list" class="participants-list"></div>
      </section>
    </div>

    <div class="float-shapes" aria-hidden="true">
      <span class="shape shape-1">🏆</span>
      <span class="shape shape-2">⚙️</span>
      <span class="shape shape-3">🗳️</span>
    </div>
  </main>
</Base>

<script>
  import { supabase } from '../lib/supabase';
  import { getStoredPlayer } from '../lib/identity';
  import { redirectIfMaintenance } from '../lib/maintenance';
  import { renderPollCard, type PollCardPlayer } from '../lib/pollCard';
  import { computePollLeader } from '../lib/pollSummary';
  import { playerAvatarHtml } from '../lib/playerAvatar';

  const base = import.meta.env.BASE_URL;

  document.addEventListener('astro:page-load', start);

  async function start() {
    if (await redirectIfMaintenance(base)) return;
    init(getStoredPlayer());
  }

  let allVotesState: any[] = [];
  let pendingPolls: any[] = [];
  let pollWidgetIdx = 0;
  let allPollsForResults: any[] = [];
  let resultsIdx = 0;

  async function init(player: PollCardPlayer) {
    const loading = document.getElementById('widgets-loading')!;
    const errorMsg = document.getElementById('widgets-error')!;
    const widgets = document.getElementById('widgets')!;

    const [pollsRes, votesRes, palmaresRes, playersRes] = await Promise.all([
      supabase
        .from('polls')
        .select(
          'id, title, description, status, poll_type, category, created_at, placeholder, min_value, max_value, allow_empty, empty_label, poll_options(id, label, hint, sort_order)'
        )
        .order('created_at', { ascending: true })
        .order('sort_order', { foreignTable: 'poll_options', ascending: true }),
      supabase.from('votes').select('id, poll_id, option_id, text_value, player_id'),
      supabase.from('palmares').select('season, position, name, image_url').order('position', { ascending: true }),
      supabase.from('players').select('id, name, emoji, full_name, avatar_url').order('name', { ascending: true }),
    ]);

    if (pollsRes.error || votesRes.error || palmaresRes.error || playersRes.error) {
      loading.hidden = true;
      errorMsg.hidden = false;
      return;
    }

    loading.hidden = true;
    widgets.hidden = false;

    allVotesState = votesRes.data ?? [];
    allPollsForResults = pollsRes.data ?? [];
    pendingPolls = player
      ? allPollsForResults.filter(
          (poll) => poll.status === 'open' && !allVotesState.some((v) => v.poll_id === poll.id && v.player_id === player.id)
        )
      : [];

    setupPollWidget(player);
    setupResultsWidget();
    renderPalmaresMini(palmaresRes.data ?? []);
    renderParticipants(playersRes.data ?? []);
  }

  function setupPollWidget(player: PollCardPlayer) {
    const widget = document.getElementById('poll-widget')!;

    if (!player) {
      widget.hidden = false;
      const body = document.getElementById('poll-widget-body')!;
      body.innerHTML = `
        <div class="widget-empty">
          <p>Elegí tu nombre para ver y votar las encuestas pendientes.</p>
          <a class="btn btn-primary btn-small" href="${base}identidad">Entrar</a>
        </div>
      `;
      (document.querySelector('#poll-widget .widget-nav') as HTMLElement).hidden = true;
      return;
    }

    widget.hidden = false;
    renderCurrentPending(player);

    document.getElementById('poll-prev')!.addEventListener('click', () => {
      if (pendingPolls.length === 0) return;
      pollWidgetIdx = (pollWidgetIdx - 1 + pendingPolls.length) % pendingPolls.length;
      renderCurrentPending(player);
    });
    document.getElementById('poll-next')!.addEventListener('click', () => {
      if (pendingPolls.length === 0) return;
      pollWidgetIdx = (pollWidgetIdx + 1) % pendingPolls.length;
      renderCurrentPending(player);
    });
  }

  function renderCurrentPending(player: PollCardPlayer) {
    const body = document.getElementById('poll-widget-body')!;
    const counter = document.getElementById('poll-counter')!;
    const nav = document.querySelector('#poll-widget .widget-nav') as HTMLElement;

    if (pendingPolls.length === 0) {
      nav.hidden = true;
      body.innerHTML = `
        <div class="widget-empty">
          <p>🎉 ¡Votaste todo lo que está abierto!</p>
          <a class="btn btn-ghost btn-small" href="${base}resultados">Ver resultados</a>
        </div>
      `;
      return;
    }

    nav.hidden = pendingPolls.length <= 1;
    if (pollWidgetIdx >= pendingPolls.length) pollWidgetIdx = 0;
    const poll = pendingPolls[pollWidgetIdx];

    body.innerHTML = '';
    body.appendChild(
      renderPollCard(
        poll,
        allVotesState,
        player,
        (updated) => {
          allVotesState = updated;
          advanceAfterVote(poll, player);
        },
        { selfUpdate: false }
      )
    );
    counter.textContent = `${pollWidgetIdx + 1} / ${pendingPolls.length}`;
  }

  function advanceAfterVote(votedPoll: any, player: PollCardPlayer) {
    const body = document.getElementById('poll-widget-body')!;
    const card = body.firstElementChild as HTMLElement | null;

    pendingPolls = pendingPolls.filter((p) => p.id !== votedPoll.id);

    if (!card) {
      renderCurrentPending(player);
      return;
    }

    card.classList.add('slide-out');
    card.addEventListener(
      'transitionend',
      () => {
        renderCurrentPending(player);
      },
      { once: true }
    );
  }

  function setupResultsWidget() {
    const widget = document.getElementById('results-widget')!;
    if (allPollsForResults.length === 0) {
      widget.hidden = true;
      return;
    }
    widget.hidden = false;
    renderCurrentResult();

    document.getElementById('results-prev')!.addEventListener('click', () => {
      resultsIdx = (resultsIdx - 1 + allPollsForResults.length) % allPollsForResults.length;
      renderCurrentResult();
    });
    document.getElementById('results-next')!.addEventListener('click', () => {
      resultsIdx = (resultsIdx + 1) % allPollsForResults.length;
      renderCurrentResult();
    });
  }

  function renderCurrentResult() {
    const body = document.getElementById('results-widget-body')!;
    const counter = document.getElementById('results-counter')!;
    const poll = allPollsForResults[resultsIdx];
    const leader = computePollLeader(poll, allVotesState);

    body.innerHTML = `
      <span class="result-mini-cat">${poll.category ?? 'Otras'}</span>
      <span class="result-mini-title">${poll.title}</span>
      <div class="result-mini-leader">
        <span class="result-mini-leader-label ${leader.className}">${leader.label}</span>
        <span class="result-mini-leader-pct">${leader.pctText}</span>
      </div>
    `;
    counter.textContent = `${resultsIdx + 1} / ${allPollsForResults.length}`;
  }

  function renderPalmaresMini(entries: any[]) {
    const widget = document.getElementById('palmares-widget')!;
    const mini = document.getElementById('palmares-mini')!;

    if (entries.length === 0) {
      widget.hidden = true;
      return;
    }

    widget.hidden = false;
    const MEDALS: Record<number, string> = { 1: '🥇', 2: '🥈', 3: '🥉' };
    const itemHtml = (e: any) => `
      <div class="palmares-mini-item${e.position === 1 ? ' is-first' : ''}">
        <div class="palmares-mini-avatar">
          ${e.image_url ? `<img src="${base}${e.image_url}" alt="${e.name}" />` : MEDALS[e.position] ?? '⚽'}
        </div>
        <span class="palmares-mini-medal">${MEDALS[e.position] ?? ''}</span>
        <span class="palmares-mini-name">${e.name}</span>
      </div>
    `;

    const first = entries.find((e) => e.position === 1);
    const rest = entries.filter((e) => e.position !== 1);

    mini.innerHTML = `
      ${first ? `<div class="palmares-podium-top">${itemHtml(first)}</div>` : ''}
      <div class="palmares-podium-bottom">${rest.map(itemHtml).join('')}</div>
    `;
  }

  function renderParticipants(players: any[]) {
    const widget = document.getElementById('participants-widget')!;
    const list = document.getElementById('participants-list')!;
    const count = document.getElementById('participants-count')!;

    if (players.length === 0) {
      widget.hidden = true;
      return;
    }

    widget.hidden = false;
    count.textContent = `${players.length}`;
    list.innerHTML = players
      .map(
        (p) => `
        <div class="participant-row">
          ${playerAvatarHtml(p, base, 'participant-avatar')}
          <div class="participant-names">
            <span class="participant-nick">${p.name}</span>
            ${p.full_name ? `<span class="participant-full">${p.full_name}</span>` : ''}
          </div>
        </div>
      `
      )
      .join('');
  }
</script>

<style>
  .home {
    justify-content: center;
    align-items: center;
    text-align: center;
    position: relative;
    overflow: hidden;
    gap: 1.5rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    max-width: 28rem;
    z-index: 1;
  }

  h1 {
    font-size: clamp(1.25rem, 4.2vw, 1.9rem);
  }

  .state-msg {
    color: var(--text-dim);
    padding: 2rem 0;
    text-align: center;
  }

  .state-msg.error {
    color: var(--danger);
  }

  .widgets {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    width: 100%;
    max-width: 32rem;
    z-index: 1;
  }

  :global(.widget) {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem;
    box-shadow: var(--shadow);
    text-align: left;
  }

  :global(.widget-head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }

  :global(.widget-title) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
  }

  :global(.widget-link) {
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
    flex-shrink: 0;
  }

  :global(.poll-widget-viewport) {
    overflow: hidden;
  }

  :global(.widget .poll-card) {
    padding: 1.1rem;
  }

  :global(.slide-out) {
    transition: transform 0.3s ease, opacity 0.3s ease;
    transform: translateX(-115%);
    opacity: 0;
  }

  :global(.widget-empty) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-align: center;
    padding: 1rem 0.5rem;
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  :global(.widget-nav) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.85rem;
  }

  :global(.widget-nav-btn) {
    appearance: none;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text);
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.15s ease;
  }

  :global(.widget-nav-btn:hover) {
    border-color: var(--accent-dim);
  }

  :global(.widget-counter) {
    color: var(--text-dim);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    min-width: 3rem;
    text-align: center;
  }

  :global(.result-mini) {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1rem;
  }

  :global(.result-mini-cat) {
    color: var(--gold);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  :global(.result-mini-title) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.98rem;
  }

  :global(.result-mini-leader) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.4rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border);
  }

  :global(.result-mini-leader-label) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.92rem;
  }

  :global(.result-mini-leader-label.is-empty) {
    color: var(--text-dim);
    font-family: var(--font-body);
    font-weight: 400;
    font-style: italic;
  }

  :global(.result-mini-leader-pct) {
    color: var(--accent);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  :global(.palmares-mini) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  :global(.palmares-podium-bottom) {
    display: flex;
    justify-content: center;
    gap: 1.75rem;
  }

  :global(.palmares-mini-item) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    text-align: center;
  }

  :global(.palmares-mini-avatar) {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--bg-card);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    overflow: hidden;
  }

  :global(.palmares-mini-item.is-first .palmares-mini-avatar) {
    width: 6rem;
    height: 6rem;
    font-size: 2.2rem;
    border-color: var(--gold);
  }

  :global(.palmares-mini-avatar img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.palmares-mini-medal) {
    font-size: 0.85rem;
  }

  :global(.palmares-mini-item.is-first .palmares-mini-medal) {
    font-size: 1.3rem;
  }

  :global(.palmares-mini-name) {
    font-size: 0.72rem;
    font-weight: 600;
    max-width: 5.5rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.palmares-mini-item.is-first .palmares-mini-name) {
    font-size: 0.85rem;
    max-width: 8rem;
  }

  :global(.participants-list) {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  :global(.participant-row) {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0;
    border-top: 1px solid var(--border);
  }

  :global(.participant-row:first-child) {
    border-top: none;
  }

  :global(.participant-avatar.player-avatar-img) {
    width: 3.5rem;
    height: 3.5rem;
    flex-shrink: 0;
  }

  :global(.participant-avatar.player-avatar-emoji) {
    font-size: 2.2rem;
    width: 3.5rem;
    text-align: center;
    flex-shrink: 0;
  }

  :global(.participant-names) {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  :global(.participant-nick) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.92rem;
  }

  :global(.participant-full) {
    color: var(--text-dim);
    font-size: 0.75rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .float-shapes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .shape {
    position: absolute;
    font-size: 2.5rem;
    opacity: 0.2;
    animation: float 5s ease-in-out infinite;
  }

  .shape-1 { top: 6%; left: 6%; animation-delay: 0s; }
  .shape-2 { top: 8%; right: 8%; animation-delay: 1.2s; }
  .shape-3 { bottom: 4%; left: 12%; animation-delay: 2.1s; }

  @media (max-width: 480px) {
    .shape { font-size: 1.8rem; }
  }

  /* ---------- desktop: the single-column mobile layout looks sparse on
     a big screen, so widen everything out and bump sizes up ---------- */
  @media (min-width: 860px) {
    .home {
      max-width: 76rem;
      gap: 2.5rem;
      padding-top: 3rem;
      padding-bottom: 3rem;
    }

    .hero-content {
      max-width: 42rem;
      gap: 1rem;
    }

    h1 {
      font-size: 2.5rem;
    }

    .badge {
      font-size: 0.9rem;
      padding: 0.4rem 0.9rem;
    }

    .widgets {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: 1.75rem;
      max-width: 100%;
    }

    :global(.widget) {
      padding: 1.75rem;
    }

    :global(.widget-title) {
      font-size: 1.15rem;
    }

    :global(.widget-link) {
      font-size: 0.9rem;
    }

    :global(.widget .poll-card) {
      padding: 1.5rem;
    }

    :global(.widget .poll-title) {
      font-size: 1.3rem;
    }

    :global(.widget .poll-desc) {
      font-size: 1rem;
    }

    :global(.widget .option-btn) {
      padding: 0.9rem 1.1rem;
      font-size: 1.02rem;
    }

    :global(.widget-empty) {
      font-size: 1.02rem;
      padding: 1.75rem 1rem;
    }

    :global(.widget-nav-btn) {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1.15rem;
    }

    :global(.widget-counter) {
      font-size: 0.9rem;
    }

    :global(.result-mini) {
      padding: 1.5rem;
      gap: 0.5rem;
    }

    :global(.result-mini-cat) {
      font-size: 0.78rem;
    }

    :global(.result-mini-title) {
      font-size: 1.2rem;
    }

    :global(.result-mini-leader-label) {
      font-size: 1.1rem;
    }

    :global(.result-mini-leader-pct) {
      font-size: 0.95rem;
    }

    :global(.palmares-mini-avatar) {
      width: 4.5rem;
      height: 4.5rem;
      font-size: 1.5rem;
    }

    :global(.palmares-mini-item.is-first .palmares-mini-avatar) {
      width: 9rem;
      height: 9rem;
      font-size: 3rem;
    }

    :global(.palmares-mini-medal) {
      font-size: 1.15rem;
    }

    :global(.palmares-mini-item.is-first .palmares-mini-medal) {
      font-size: 1.6rem;
    }

    :global(.palmares-mini-name) {
      font-size: 0.9rem;
      max-width: 7.5rem;
    }

    :global(.palmares-mini-item.is-first .palmares-mini-name) {
      font-size: 1.05rem;
      max-width: 10rem;
    }

    :global(.participant-row) {
      gap: 0.9rem;
      padding: 0.75rem 0;
    }

    :global(.participant-avatar.player-avatar-img) {
      width: 4.5rem;
      height: 4.5rem;
    }

    :global(.participant-avatar.player-avatar-emoji) {
      width: 4.5rem;
      font-size: 2.8rem;
    }

    :global(.participant-nick) {
      font-size: 1.05rem;
    }

    :global(.participant-full) {
      font-size: 0.85rem;
    }
  }
</style>
