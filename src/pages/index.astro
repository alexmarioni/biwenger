---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="Bienvenida">
  <main class="wrap home">
    <div class="hero-content animate-in">
      <span class="badge">⚽ Liga Biwenger</span>
      <h1>Decidamos entre todos cómo se juega esta liga.</h1>
    </div>

    <div id="widgets-loading" class="state-msg">Cargando…</div>
    <div id="widgets-error" class="state-msg error" hidden>
      No se pudo conectar con la base. Revisá tu conexión o probá de nuevo en un rato.
    </div>

    <section id="pinned-widget" class="pinned-widget" hidden></section>

    <div id="widgets" class="widgets stagger" hidden>
      <section id="poll-widget" class="widget" hidden>
        <div class="widget-head">
          <span class="widget-title">🗳️ Encuestas</span>
          <a class="widget-link" href={`${base}votaciones`}>Ver todas →</a>
        </div>
        <div class="poll-widget-viewport">
          <div id="poll-widget-body"></div>
        </div>
        <div class="widget-nav">
          <button id="poll-prev" class="widget-nav-btn" type="button" aria-label="Anterior">‹</button>
          <span id="poll-counter" class="widget-counter"></span>
          <button id="poll-next" class="widget-nav-btn" type="button" aria-label="Siguiente">›</button>
        </div>
      </section>

      <section id="results-widget" class="widget" hidden>
        <div class="widget-head">
          <span class="widget-title">📊 Resultados</span>
          <a class="widget-link" href={`${base}resultados`}>Ver todos →</a>
        </div>
        <div id="results-widget-body" class="result-mini"></div>
        <div class="widget-nav">
          <button id="results-prev" class="widget-nav-btn" type="button" aria-label="Anterior">‹</button>
          <span id="results-counter" class="widget-counter"></span>
          <button id="results-next" class="widget-nav-btn" type="button" aria-label="Siguiente">›</button>
        </div>
      </section>

      <section id="minijuegos-widget" class="widget" hidden>
        <div class="widget-head">
          <span class="widget-title">🎮 Minijuegos</span>
          <a class="widget-link" href={`${base}predicciones`}>Ver todas →</a>
        </div>
        <div class="poll-widget-viewport">
          <div id="minijuegos-widget-body"></div>
        </div>
        <div class="widget-nav">
          <button id="minijuegos-prev" class="widget-nav-btn" type="button" aria-label="Anterior">‹</button>
          <span id="minijuegos-counter" class="widget-counter"></span>
          <button id="minijuegos-next" class="widget-nav-btn" type="button" aria-label="Siguiente">›</button>
        </div>
      </section>

      <section id="jornada-widget" class="widget jornada-widget" hidden>
        <div class="widget-head">
          <span class="widget-title">⚽ Jornada</span>
          <a class="widget-link" href={`${base}predicciones`}>Ver todas →</a>
        </div>
        <div id="jornada-widget-body"></div>
      </section>

      <section id="clasificacion-widget" class="widget" hidden>
        <div class="widget-head">
          <span class="widget-title">🏆 Clasificación</span>
        </div>
        <div id="clasificacion-widget-body"></div>
      </section>

      <section id="palmares-widget" class="widget" hidden>
        <div class="widget-head">
          <span class="widget-title">🏆 Palmarés</span>
          <a class="widget-link" href={`${base}palmares`}>Ver completo →</a>
        </div>
        <div id="palmares-mini" class="palmares-mini"></div>
      </section>

      <section id="participants-widget" class="widget" hidden>
        <div class="widget-head">
          <span class="widget-title">👥 Participantes</span>
          <span class="widget-counter" id="participants-count"></span>
        </div>
        <div id="participants-list" class="participants-list"></div>
      </section>
    </div>

    <div class="float-shapes" aria-hidden="true">
      <span class="shape shape-1">🏆</span>
      <span class="shape shape-2">⚙️</span>
      <span class="shape shape-3">🗳️</span>
    </div>
  </main>
</Base>

<script>
  import { supabase } from '../lib/supabase';
  import { getStoredPlayer } from '../lib/identity';
  import { redirectIfMaintenance } from '../lib/maintenance';
  import { renderPollCard, type PollCardPlayer } from '../lib/pollCard';
  import { renderMatchCard } from '../lib/matchCard';
  import { computePollLeader } from '../lib/pollSummary';
  import { playerAvatarHtml } from '../lib/playerAvatar';

  const base = import.meta.env.BASE_URL;

  document.addEventListener('astro:page-load', start);

  async function start() {
    if (await redirectIfMaintenance(base)) return;
    init(getStoredPlayer());
  }

  let allVotesState: any[] = [];
  let allPollsForResults: any[] = [];
  let resultsPolls: any[] = [];
  let resultsIdx = 0;

  async function init(player: PollCardPlayer) {
    const loading = document.getElementById('widgets-loading')!;
    const errorMsg = document.getElementById('widgets-error')!;
    const widgets = document.getElementById('widgets')!;

    const [pollsRes, votesRes, palmaresRes, playersRes] = await Promise.all([
      supabase
        .from('polls')
        .select(
          'id, title, description, status, poll_type, category, created_at, featured, placeholder, min_value, max_value, allow_empty, empty_label, venue, kickoff_at, poll_options(id, label, hint, sort_order)'
        )
        .order('created_at', { ascending: true })
        .order('sort_order', { foreignTable: 'poll_options', ascending: true }),
      supabase.from('votes').select('id, poll_id, option_id, text_value, player_id'),
      supabase.from('palmares').select('season, position, name, image_url').order('position', { ascending: true }),
      supabase.from('players').select('id, name, emoji, full_name, avatar_url').order('name', { ascending: true }),
    ]);

    if (pollsRes.error || votesRes.error || palmaresRes.error || playersRes.error) {
      loading.hidden = true;
      errorMsg.hidden = false;
      return;
    }

    loading.hidden = true;
    widgets.hidden = false;

    allVotesState = votesRes.data ?? [];
    allPollsForResults = pollsRes.data ?? [];

    encuestasCarousel.setup(player);
    minijuegosCarousel.setup(player);
    setupJornadaWidget(player);
    setupClasificacionWidget(player);
    setupResultsWidget();
    renderPalmaresMini(palmaresRes.data ?? []);
    renderParticipants(playersRes.data ?? []);
    renderPinned(allPollsForResults.filter((poll) => poll.featured), player);
  }

  /** A "show one pending poll at a time, slide out on vote" mini carousel,
   * reused for both the Encuestas and Minijuegos widgets. */
  function createPendingCarousel(config: {
    widgetId: string;
    bodyId: string;
    counterId: string;
    prevId: string;
    nextId: string;
    loginPrompt: string;
    doneHtml: string;
    filterFn: (poll: any) => boolean;
  }) {
    let idx = 0;
    let items: any[] = [];

    function computeItems(player: PollCardPlayer) {
      items = player
        ? allPollsForResults.filter(
            (poll) =>
              config.filterFn(poll) &&
              poll.status === 'open' &&
              !allVotesState.some((v) => v.poll_id === poll.id && v.player_id === player.id)
          )
        : [];
    }

    function setup(player: PollCardPlayer) {
      const widget = document.getElementById(config.widgetId)!;
      const total = allPollsForResults.filter(config.filterFn).length;

      if (total === 0) {
        widget.hidden = true;
        return;
      }

      if (!player) {
        widget.hidden = false;
        document.getElementById(config.bodyId)!.innerHTML = `
          <div class="widget-empty">
            <p>${config.loginPrompt}</p>
            <a class="btn btn-primary btn-small" href="${base}identidad">Entrar</a>
          </div>
        `;
        (document.querySelector(`#${config.widgetId} .widget-nav`) as HTMLElement).hidden = true;
        return;
      }

      widget.hidden = false;
      computeItems(player);
      render(player);

      document.getElementById(config.prevId)!.addEventListener('click', () => {
        if (items.length === 0) return;
        idx = (idx - 1 + items.length) % items.length;
        render(player);
      });
      document.getElementById(config.nextId)!.addEventListener('click', () => {
        if (items.length === 0) return;
        idx = (idx + 1) % items.length;
        render(player);
      });
    }

    function render(player: PollCardPlayer) {
      const body = document.getElementById(config.bodyId)!;
      const counter = document.getElementById(config.counterId)!;
      const nav = document.querySelector(`#${config.widgetId} .widget-nav`) as HTMLElement;

      if (items.length === 0) {
        nav.hidden = true;
        body.innerHTML = config.doneHtml;
        return;
      }

      nav.hidden = items.length <= 1;
      if (idx >= items.length) idx = 0;
      const poll = items[idx];

      body.innerHTML = '';
      body.appendChild(
        renderPollCard(
          poll,
          allVotesState,
          player,
          (updated) => {
            allVotesState = updated;
            advance(poll, player);
          },
          { selfUpdate: false }
        )
      );

      counter.textContent = `${idx + 1} / ${items.length}`;
    }

    function advance(votedPoll: any, player: PollCardPlayer) {
      const body = document.getElementById(config.bodyId)!;
      const card = body.firstElementChild as HTMLElement | null;

      items = items.filter((p) => p.id !== votedPoll.id);

      if (!card) {
        render(player);
        return;
      }

      card.classList.add('slide-out');
      card.addEventListener('transitionend', () => render(player), { once: true });
    }

    return { setup };
  }

  const encuestasCarousel = createPendingCarousel({
    widgetId: 'poll-widget',
    bodyId: 'poll-widget-body',
    counterId: 'poll-counter',
    prevId: 'poll-prev',
    nextId: 'poll-next',
    loginPrompt: 'Elegí tu nombre para ver y votar las encuestas pendientes.',
    doneHtml: `
      <div class="widget-empty">
        <p>🎉 ¡Votaste todo lo que está abierto!</p>
        <a class="btn btn-ghost btn-small" href="${base}resultados">Ver resultados</a>
      </div>
    `,
    filterFn: (poll) => !poll.featured && poll.category !== 'Minijuegos' && poll.category !== 'Jornada',
  });

  const minijuegosCarousel = createPendingCarousel({
    widgetId: 'minijuegos-widget',
    bodyId: 'minijuegos-widget-body',
    counterId: 'minijuegos-counter',
    prevId: 'minijuegos-prev',
    nextId: 'minijuegos-next',
    loginPrompt: 'Elegí tu nombre para participar de los minijuegos.',
    doneHtml: `
      <div class="widget-empty">
        <p>🎉 ¡Ya predijiste todo lo que hay!</p>
      </div>
    `,
    filterFn: (poll) => poll.category === 'Minijuegos',
  });

  function setupJornadaWidget(player: PollCardPlayer) {
    const widget = document.getElementById('jornada-widget')!;
    const body = document.getElementById('jornada-widget-body')!;
    const matches = allPollsForResults
      .filter((poll) => poll.category === 'Jornada' && poll.status === 'open')
      .sort((a, b) => (a.kickoff_at ?? '').localeCompare(b.kickoff_at ?? ''));

    if (matches.length === 0) {
      widget.hidden = true;
      return;
    }

    widget.hidden = false;

    if (!player) {
      body.innerHTML = `
        <div class="widget-empty">
          <p>Elegí tu nombre para pronosticar los partidos.</p>
          <a class="btn btn-primary btn-small" href="${base}identidad">Entrar</a>
        </div>
      `;
      return;
    }

    body.innerHTML = '';
    body.className = 'jornada-list';
    for (const poll of matches) {
      body.appendChild(
        renderMatchCard(
          poll,
          allVotesState,
          player,
          (updated) => {
            allVotesState = updated;
          },
          base
        )
      );
    }
  }

  function setupClasificacionWidget(player: PollCardPlayer) {
    const widget = document.getElementById('clasificacion-widget')!;
    const poll = allPollsForResults.find((poll) => poll.category === 'Clasificación');

    if (!poll) {
      widget.hidden = true;
      return;
    }

    widget.hidden = false;
    const body = document.getElementById('clasificacion-widget-body')!;

    if (!player) {
      body.innerHTML = `
        <div class="widget-empty">
          <p>Elegí tu nombre para armar tu pronóstico de la tabla.</p>
          <a class="btn btn-primary btn-small" href="${base}identidad">Entrar</a>
        </div>
      `;
      return;
    }

    const myVote = allVotesState.some((v) => v.poll_id === poll.id && v.player_id === player.id);
    body.innerHTML = `
      <div class="widget-empty">
        <p>${myVote ? 'Ya armaste tu pronóstico de la tabla. ¿Lo querés retocar?' : 'Arrastrá los 20 equipos y armá tu pronóstico de la tabla final.'}</p>
        <a class="btn btn-primary btn-small" href="${base}predicciones#clasificacion">${myVote ? 'Editar pronóstico' : 'Armar pronóstico'} →</a>
      </div>
    `;
  }

  function setupResultsWidget() {
    const widget = document.getElementById('results-widget')!;
    // 'ranking' (Clasificación) stores a JSON array, not a single
    // human-readable leader — it has its own comparison view on
    // /predicciones, so skip it here.
    resultsPolls = allPollsForResults.filter((poll) => poll.poll_type !== 'ranking');
    if (resultsPolls.length === 0) {
      widget.hidden = true;
      return;
    }
    widget.hidden = false;
    renderCurrentResult();

    document.getElementById('results-prev')!.addEventListener('click', () => {
      resultsIdx = (resultsIdx - 1 + resultsPolls.length) % resultsPolls.length;
      renderCurrentResult();
    });
    document.getElementById('results-next')!.addEventListener('click', () => {
      resultsIdx = (resultsIdx + 1) % resultsPolls.length;
      renderCurrentResult();
    });
  }

  function renderCurrentResult() {
    const body = document.getElementById('results-widget-body')!;
    const counter = document.getElementById('results-counter')!;
    const poll = resultsPolls[resultsIdx];
    const leader = computePollLeader(poll, allVotesState);

    body.innerHTML = `
      <span class="result-mini-cat">${poll.category ?? 'Otras'}</span>
      <span class="result-mini-title">${poll.title}</span>
      <div class="result-mini-leader">
        <span class="result-mini-leader-label ${leader.className}">${leader.label}</span>
        <span class="result-mini-leader-pct">${leader.pctText}</span>
      </div>
    `;
    counter.textContent = `${resultsIdx + 1} / ${resultsPolls.length}`;
  }

  function renderPalmaresMini(entries: any[]) {
    const widget = document.getElementById('palmares-widget')!;
    const mini = document.getElementById('palmares-mini')!;

    if (entries.length === 0) {
      widget.hidden = true;
      return;
    }

    widget.hidden = false;
    const MEDALS: Record<number, string> = { 1: '🥇', 2: '🥈', 3: '🥉' };
    const itemHtml = (e: any) => `
      <div class="palmares-mini-item${e.position === 1 ? ' is-first' : ''}">
        <div class="palmares-mini-avatar">
          ${e.image_url ? `<img src="${base}${e.image_url}" alt="${e.name}" />` : MEDALS[e.position] ?? '⚽'}
        </div>
        <span class="palmares-mini-medal">${MEDALS[e.position] ?? ''}</span>
        <span class="palmares-mini-name">${e.name}</span>
      </div>
    `;

    const first = entries.find((e) => e.position === 1);
    const rest = entries.filter((e) => e.position !== 1);

    mini.innerHTML = `
      ${first ? `<div class="palmares-podium-top">${itemHtml(first)}</div>` : ''}
      <div class="palmares-podium-bottom">${rest.map(itemHtml).join('')}</div>
    `;
  }

  function renderParticipants(players: any[]) {
    const widget = document.getElementById('participants-widget')!;
    const list = document.getElementById('participants-list')!;
    const count = document.getElementById('participants-count')!;

    if (players.length === 0) {
      widget.hidden = true;
      return;
    }

    widget.hidden = false;
    count.textContent = `${players.length}`;
    list.innerHTML = players
      .map(
        (p) => `
        <div class="participant-row">
          ${playerAvatarHtml(p, base, 'participant-avatar')}
          <div class="participant-names">
            <span class="participant-nick">${p.name}</span>
            ${p.full_name ? `<span class="participant-full">${p.full_name}</span>` : ''}
          </div>
        </div>
      `
      )
      .join('');
  }

  function renderPinned(polls: any[], player: PollCardPlayer) {
    const section = document.getElementById('pinned-widget')!;

    if (polls.length === 0) {
      section.hidden = true;
      return;
    }

    section.hidden = false;
    section.innerHTML = '';

    for (const poll of polls) {
      const wrap = document.createElement('div');
      wrap.className = 'featured-wrap';

      const badge = document.createElement('div');
      badge.className = 'featured-badge';
      badge.textContent = '🆕 Novedad';
      wrap.appendChild(badge);

      const card = renderPollCard(poll, allVotesState, player, (updated) => {
        allVotesState = updated;
      });
      card.classList.add('featured-card');
      wrap.appendChild(card);

      section.appendChild(wrap);
    }
  }
</script>

<style>
  .home {
    justify-content: center;
    align-items: center;
    text-align: center;
    position: relative;
    overflow: hidden;
    gap: 1.5rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    max-width: 28rem;
    z-index: 1;
  }

  h1 {
    font-size: clamp(1.25rem, 4.2vw, 1.9rem);
  }

  .state-msg {
    color: var(--text-dim);
    padding: 2rem 0;
    text-align: center;
  }

  .state-msg.error {
    color: var(--danger);
  }

  .widgets {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    width: 100%;
    max-width: 32rem;
    z-index: 1;
  }

  :global(.widget) {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem;
    box-shadow: var(--shadow);
    text-align: left;
  }

  :global(.widget-head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }

  :global(.widget-title) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
  }

  :global(.widget-link) {
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
    flex-shrink: 0;
  }

  :global(.poll-widget-viewport) {
    overflow: hidden;
  }

  :global(.widget .poll-card) {
    padding: 1.1rem;
  }

  .pinned-widget {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    z-index: 1;
  }

  :global(.slide-out) {
    transition: transform 0.3s ease, opacity 0.3s ease;
    transform: translateX(-115%);
    opacity: 0;
  }

  :global(.widget-empty) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-align: center;
    padding: 1rem 0.5rem;
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  :global(.widget-nav) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.85rem;
  }

  :global(.widget-nav-btn) {
    appearance: none;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text);
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.15s ease;
  }

  :global(.widget-nav-btn:hover) {
    border-color: var(--accent-dim);
  }

  :global(.widget-counter) {
    color: var(--text-dim);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    min-width: 3rem;
    text-align: center;
  }

  :global(.result-mini) {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1rem;
  }

  :global(.result-mini-cat) {
    color: var(--gold);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  :global(.result-mini-title) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.98rem;
  }

  :global(.result-mini-leader) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.4rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border);
  }

  :global(.result-mini-leader-label) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.92rem;
  }

  :global(.result-mini-leader-label.is-empty) {
    color: var(--text-dim);
    font-family: var(--font-body);
    font-weight: 400;
    font-style: italic;
  }

  :global(.result-mini-leader-pct) {
    color: var(--accent);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  :global(.palmares-mini) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  :global(.palmares-podium-bottom) {
    display: flex;
    justify-content: center;
    gap: 1.75rem;
  }

  :global(.palmares-mini-item) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    text-align: center;
  }

  :global(.palmares-mini-avatar) {
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }

  :global(.palmares-mini-item.is-first .palmares-mini-avatar) {
    width: 6rem;
    height: 6rem;
    font-size: 2.2rem;
  }

  :global(.palmares-mini-avatar img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  :global(.palmares-mini-medal) {
    font-size: 0.85rem;
  }

  :global(.palmares-mini-item.is-first .palmares-mini-medal) {
    font-size: 1.3rem;
  }

  :global(.palmares-mini-name) {
    font-size: 0.72rem;
    font-weight: 600;
    max-width: 5.5rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.palmares-mini-item.is-first .palmares-mini-name) {
    font-size: 0.85rem;
    max-width: 8rem;
  }

  :global(.participants-list) {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  :global(.participant-row) {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0;
