---
import Base from '../layouts/Base.astro';
---

<Base title="¿Quién sos?">
  <main class="wrap identidad">
    <div class="animate-in">
      <h1>¿Quién sos?</h1>
      <p class="lead">Elegí tu nombre para poder votar.</p>
    </div>

    <div id="state-loading" class="state-msg">Cargando jugadores…</div>
    <div id="state-error" class="state-msg error" hidden>
      No se pudo conectar con la base. Revisá tu conexión o probá de nuevo en un rato.
    </div>

    <div id="players-grid" class="players-grid stagger" hidden></div>
  </main>
</Base>

<style>
  .identidad {
    justify-content: center;
    gap: 2rem;
    text-align: center;
  }

  h1 {
    font-size: clamp(1.6rem, 4.5vw, 2.1rem);
  }

  .lead {
    color: var(--text-dim);
    margin-top: 0.5rem;
  }

  .state-msg {
    color: var(--text-dim);
    padding: 2rem 0;
  }

  .state-msg.error {
    color: var(--danger);
  }

  .players-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 1rem;
  }

  :global(.player-card) {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 600;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }

  :global(.player-card:hover) {
    transform: translateY(-4px);
    border-color: var(--accent-dim);
    box-shadow: var(--shadow);
  }

  :global(.player-card:active) {
    transform: scale(0.96);
  }

  :global(.player-emoji) {
    font-size: 2.2rem;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { getStoredPlayer, setStoredPlayer } from '../lib/identity';

  const base = import.meta.env.BASE_URL;

  const existing = getStoredPlayer();
  if (existing) {
    window.location.href = `${base}votaciones`;
  } else {
    init();
  }

  async function init() {
    const loading = document.getElementById('state-loading')!;
    const errorMsg = document.getElementById('state-error')!;
    const grid = document.getElementById('players-grid')!;

    const { data, error } = await supabase
      .from('players')
      .select('id, name, emoji')
      .order('name', { ascending: true });

    loading.hidden = true;

    if (error || !data || data.length === 0) {
      errorMsg.hidden = false;
      return;
    }

    grid.hidden = false;
    grid.innerHTML = '';

    for (const player of data) {
      const card = document.createElement('button');
      card.type = 'button';
      card.className = 'player-card';
      card.innerHTML = `
        <span class="player-emoji">${player.emoji ?? '⚽'}</span>
        <span>${player.name}</span>
      `;
      card.addEventListener('click', () => {
        setStoredPlayer({ id: player.id, name: player.name, emoji: player.emoji ?? '⚽' });
        window.location.href = `${base}votaciones`;
      });
      grid.appendChild(card);
    }
  }
</script>
